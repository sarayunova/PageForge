# PageForge hosted-API local configuration template.
#
# Copy to `.env` and keep it out of source control (it holds secrets). The
# values below are the `docker compose up -d` defaults from docker-compose.yml,
# so a fresh developer machine can bring up the whole stack and run the API
# without editing anything:
#
#     docker compose up -d
#     tools/run-api.ps1            # or: dotnet run --project services/PageForge.Api
#
# Every value maps 1:1 to a key the API reads from configuration (EF
# connection string, JWT, provider-gated OAuth, Stripe, MinIO sync blobs,
# SMTP via Mailpit, OCR quotas). To override at runtime, either edit this file
# (requires restart) or set the matching environment variable with the
# section-name double-underscore convention, e.g. `Email__Host=mysmtp.local`.

# ---------------------------------------------------------------------------
# Database (EF Core / PostgreSQL). Matches the `postgres` compose service.
# ---------------------------------------------------------------------------
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=pageforge;Username=postgres;Password=postgres

# ---------------------------------------------------------------------------
# JWT (the API will not start without a symmetric key). Dev-only value below;
# production must rotate to a random 256-bit key kept in the secret store.
# ---------------------------------------------------------------------------
Jwt__Key=dev-only-32-byte-secret-change-me-0000000000000000
Jwt__Issuer=PageForge
Jwt__Audience=PageForge
Jwt__AccessExpiryMinutes=15

# ---------------------------------------------------------------------------
# Sync blob storage (MinIO/S3). Matches the `minio` compose service
# (minioadmin/minioadmin); `Sync__UseSsl=false` because compose exposes plain
# HTTP on localhost:9000. Bucket is auto-created by the API on first start.
# ---------------------------------------------------------------------------
Sync__Endpoint=localhost
Sync__Port=9000
Sync__AccessKey=minioadmin
Sync__SecretKey=minioadmin
Sync__UseSsl=false
Sync__Bucket=pageforge-documents

# ---------------------------------------------------------------------------
# Email. Dev default is the Mailpit compose service (SMTP 1025, web UI at
# http://localhost:8025) — mail is captured locally, never delivered off-box.
# ---------------------------------------------------------------------------
Email__Provider=smtp
Email__Host=localhost
Email__Port=1025
Email__UseSsl=false
Email__FromAddress=no-reply@pageforge.test
Email__FromName=PageForge

# ---------------------------------------------------------------------------
# Optional dev integrations — blank by default (feature is off until filled).
# ---------------------------------------------------------------------------
PF_GOOGLE_CLIENT_ID=
PF_GOOGLE_CLIENT_SECRET=
PF_MS_CLIENT_ID=
PF_MS_CLIENT_SECRET=
PF_STRIPE_API_KEY=
PF_STRIPE_WEBHOOK_SECRET=
PF_STRIPE_MONTHLY_PRICE_ID=
PF_STRIPE_YEARLY_PRICE_ID=

# ---------------------------------------------------------------------------
# OCR quotas (hosted meters). Locally relevant only for exercising the meter.
# ---------------------------------------------------------------------------
PF_OCR_FREE_MONTHLY_PAGES=50
PF_OCR_PRO_MONTHLY_PAGES=10000