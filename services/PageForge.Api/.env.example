# PageForge hosted-API local configuration template.
#
# Placeholder values only. Nothing here is a production credential. The
# database, MinIO, and JWT entries repeat the local defaults already committed
# in docker-compose.yml and appsettings.json (postgres/postgres, minioadmin,
# and a dev-only signing key). Optional integrations are left blank, which
# leaves those features off.
#
# The API does not read this file. ASP.NET Core reads environment variables
# whose names match configuration keys with a double underscore
# (ConnectionStrings__DefaultConnection -> ConnectionStrings:DefaultConnection).
# appsettings.json already matches the compose Postgres and MinIO services, so
# a local stack needs no copy of this file:
#
#     docker compose up -d
#     dotnet run --project services/PageForge.Api
#
# To override, copy this file to `.env` (gitignored) and export the variables
# into the process environment before that `dotnet run`, or set individual
# variables in the shell. There is no tools/run-api.ps1.

# ---------------------------------------------------------------------------
# Database (EF Core / PostgreSQL). Matches the `postgres` compose service.
# ---------------------------------------------------------------------------
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=pageforge;Username=postgres;Password=postgres

# ---------------------------------------------------------------------------
# JWT (the API will not start without a symmetric key). Dev-only placeholder;
# appsettings.json ships a different dev placeholder. Production must use a
# random 256-bit key kept outside the repository.
# ---------------------------------------------------------------------------
Jwt__Key=dev-only-change-me-not-a-real-secret
Jwt__Issuer=PageForge
Jwt__Audience=PageForge
Jwt__AccessExpiryMinutes=15

# ---------------------------------------------------------------------------
# Sync blob storage (MinIO/S3). Matches the `minio` compose service
# (minioadmin/minioadmin). Sync__UseSsl=false because compose exposes plain
# HTTP on localhost:9000. The API creates the bucket on first start.
# ---------------------------------------------------------------------------
Sync__Endpoint=localhost
Sync__Port=9000
Sync__AccessKey=minioadmin
Sync__SecretKey=minioadmin
Sync__UseSsl=false
Sync__Bucket=pageforge-documents

# ---------------------------------------------------------------------------
# Email. appsettings.json defaults Provider to "none". Set smtp to use the
# Mailpit compose service (SMTP 1025, web UI at http://localhost:8025). Mail
# is captured locally and is never delivered off-box.
# ---------------------------------------------------------------------------
Email__Provider=smtp
Email__Host=localhost
Email__Port=1025
Email__UseSsl=false
Email__FromAddress=no-reply@pageforge.test
Email__FromName=PageForge

# ---------------------------------------------------------------------------
# Optional integrations. Blank leaves the feature off. Names are the
# configuration keys the API actually binds (Authentication:Google:ClientId
# and so on), not a PF_* prefix.
# ---------------------------------------------------------------------------
Authentication__Google__ClientId=
Authentication__Google__ClientSecret=
Authentication__Microsoft__ClientId=
Authentication__Microsoft__ClientSecret=
Stripe__ApiKey=
Stripe__WebhookSecret=
Stripe__MonthlyPriceId=
Stripe__YearlyPriceId=

# ---------------------------------------------------------------------------
# OCR quotas (hosted meters). appsettings.json already uses 50 and 10000.
# Uncomment to override.
# ---------------------------------------------------------------------------
# Ocr__FreeMonthlyPageQuota=50
# Ocr__ProMonthlyPageQuota=10000
