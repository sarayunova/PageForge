<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Google" Version="8.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.MicrosoftAccount" Version="8.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.11">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Minio" Version="7.0.0" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="8.0.11" />
    <PackageReference Include="Stripe.net" Version="52.4.1" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PageForge.MuPdfInterop\PageForge.MuPdfInterop.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\native\out\PageForge.MuPdfShim\Release\pageforge_mupdf.dll"
          Link="pageforge_mupdf.dll"
          CopyToOutputDirectory="PreserveNewest"
          Visible="false"
          Condition="Exists('..\..\native\out\PageForge.MuPdfShim\Release\pageforge_mupdf.dll')" />

    <!-- FR-OCR-01: bundle the vendored Tesseract English model so the real OCR
         processor works offline (matched by MuPdfEngine's tessdata search). -->
    <None Include="..\..\tools\tessdata\eng.traineddata"
          Link="tessdata\eng.traineddata"
          CopyToOutputDirectory="PreserveNewest"
          Visible="false"
          Condition="Exists('..\..\tools\tessdata\eng.traineddata')" />
  </ItemGroup>


  <!-- The payload copies above are conditional so the managed projects still
       build on a machine that has not built the native shim yet. That silence is
       dangerous in CI: with the file missing the copy is skipped, the build still
       succeeds, and everything downstream runs against no engine. That is exactly
       what happened while the native artifact was being unpacked to the wrong
       path - the suites reported green without the engine present.
       Set PAGEFORGE_REQUIRE_NATIVE=1 (ci.yml does) to make the payload mandatory. -->
  <Target Name="PageForgeVerifyNativePayload" BeforeTargets="Build"
          Condition="'$(PAGEFORGE_REQUIRE_NATIVE)' != '' and '$(PAGEFORGE_REQUIRE_NATIVE)' != '0'">
    <Error Condition="!Exists('$(MSBuildThisFileDirectory)..\..\native\out\PageForge.MuPdfShim\Release\pageforge_mupdf.dll')"
           Text="PAGEFORGE_REQUIRE_NATIVE is set but native/out/PageForge.MuPdfShim/Release/pageforge_mupdf.dll is missing. Building would silently produce an output with no PDF engine." />
    <Error Condition="!Exists('$(MSBuildThisFileDirectory)..\..\tools\tessdata\eng.traineddata')"
           Text="PAGEFORGE_REQUIRE_NATIVE is set but tools/tessdata/eng.traineddata is missing. Building would silently produce an output with no OCR language data." />
  </Target>
</Project>
