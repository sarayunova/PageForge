<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>PageForge.Fidelity.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PageForge.MuPdfInterop\PageForge.MuPdfInterop.csproj" />
    <ProjectReference Include="..\..\src\PageForge.Core\PageForge.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Phase 1 real-document fidelity corpus (manifest-driven; see docs/fidelity-corpus.md).
         Generated by tools/generate-corpus.ps1 into tools/sample-pdf/corpus/*.pdf and
         copied to the test output corpus/ directory. -->
    <None Include="..\..\tools\sample-pdf\corpus\*.pdf"
          CopyToOutputDirectory="PreserveNewest"
          Link="corpus\%(Filename)%(Extension)" />
    <None Include="..\..\tools\sample-pdf\golden\*.png"
          CopyToOutputDirectory="PreserveNewest"
          Link="golden\%(Filename)%(Extension)" />
    <!-- FR-OCR-01: bundle the vendored tessdata alongside the test binary so
         the native pdfocr bandwriter can initialise Tesseract without a
         TESSDATA_PREFIX environment variable. -->
    <None Include="..\..\tools\tessdata\eng.traineddata"
          CopyToOutputDirectory="PreserveNewest"
          Link="tessdata\eng.traineddata" />
    <None Include="corpus\manifest.psd1"
          CopyToOutputDirectory="PreserveNewest" />
    <!-- FR-PAGE verification fixture (3-page deterministic mock). -->
    <None Include="..\..\tools\sample-pdf\sample-pages3.pdf"
          CopyToOutputDirectory="PreserveNewest"
          Link="fixtures\sample-pages3.pdf" />
  </ItemGroup>

</Project>