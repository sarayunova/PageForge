<Project Sdk="Microsoft.NET.Sdk">

  <!--
    UIA-driven UI smoke tests for the WPF fallback (src/PageForge.App.Wpf).
    Replaces the WinAppDriver dependency that requires admin to install/run:
    it drives the real window through the built-in System.Windows.Automation
    (UI Automation) client, which is exactly what WinAppDriver wraps, so the
    coverage (open window, open PDF, page navigation, organize/reorder/save
    flows) is equivalent and runs fully offline on an interactive session.
    The app is launched in place from its own build output directory (a WinExe
    must run from its output folder), resolved at runtime via the repo root.

    This comment used to say the suite "runs fully offline IN CI". It did not:
    the project was in no CI lane and not even in PageForge.sln, so these four
    tests - the only ones that open the real window and check that controls are
    visible, sized and reachable - ran only when someone remembered to run them
    by hand. They are now built and executed by the `ui-smoke` lane.
  -->

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
