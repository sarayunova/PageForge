<UserControl x:Class="PageForge.App.Wpf.Views.FormFillView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <DockPanel Background="{DynamicResource CanvasBrush}">
        <!-- Form-fill toolbar -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource SurfaceRaisedBrush}" Padding="6,4">
            <!-- Commands dock right, hint takes what is left: the hint is replaced
                 at runtime with per-page messages that are far longer than this
                 default, and as a StackPanel those pushed the buttons off-screen. -->
            <DockPanel LastChildFill="True">
                <TextBlock Text="Fill form" DockPanel.Dock="Left" Foreground="{DynamicResource AccentTextBrush}" FontWeight="Bold"
                           VerticalAlignment="Center" Margin="0,0,10,0" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="New text field…" Click="NewField_Click" Padding="8,3"
                            ToolTip="Create a new AcroForm text field on this page (with required/max-length validation)" />
                    <Separator Margin="6,0" Width="1" Background="{DynamicResource EdgeStrongBrush}" />
                    <Button Content="Flatten form…" Click="Flatten_Click" Padding="8,3"
                            ToolTip="Bake every field value into static page content (fields stop being interactive)" />
                </StackPanel>
                <TextBlock x:Name="HintText" Text="Set a field value; values appear on the page at once."
                           Foreground="{DynamicResource ContentMutedBrush}" VerticalAlignment="Center" Margin="0,0,10,0"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                           AutomationProperties.LiveSetting="Polite" />
            </DockPanel>
        </Border>

        <!-- A DockPanel, not a Grid: DockPanel.Dock is an attached property that
             only means anything when the direct parent is a DockPanel. With a Grid
             here it was silently ignored, so the fields panel and the page were
             both laid out in the same single cell and the page - declared second,
             so drawn on top - hid the panel completely. -->
        <DockPanel LastChildFill="True">
            <!-- Right: fields panel -->
            <DockPanel DockPanel.Dock="Right" Width="300" Margin="4">
                <Border DockPanel.Dock="Top" Background="{DynamicResource SurfaceRaisedBrush}" Padding="6,4">
                    <TextBlock Text="Fields on this page" Foreground="{DynamicResource ContentBrush}" FontWeight="Bold" />
                </Border>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{DynamicResource SurfaceAppBrush}">
                    <StackPanel x:Name="FieldsPanel" />
                </ScrollViewer>
            </DockPanel>

            <!-- Left: page + overlay -->
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                          Background="{DynamicResource CanvasBrush}">
                <Grid x:Name="PageHost" Background="White" Margin="24">
                    <Image x:Name="PageImage" Stretch="None" SnapsToDevicePixels="True"
                       AutomationProperties.Name="Form fill page" />
                    <Canvas x:Name="Overlay" IsHitTestVisible="False" ClipToBounds="True" Focusable="True" />
                </Grid>
            </ScrollViewer>
        </DockPanel>
    </DockPanel>
</UserControl>
