<UserControl x:Class="PageForge.App.Wpf.Views.FormFillView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:locals="clr-namespace:PageForge.App.Wpf.Views">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <locals:InverseBoolToVisibilityConverter x:Key="NotBoolToVis" />
        <locals:ZeroCountToVisibilityConverter x:Key="ZeroToVis" />
    </UserControl.Resources>

    <DockPanel Background="{DynamicResource CanvasBrush}">
        <!-- Form-fill toolbar -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource SurfaceRaisedBrush}" Padding="6,4">
            <!-- Commands dock right, hint takes what is left: the hint is replaced
                 at runtime with per-page messages that are far longer than this
                 default, and as a StackPanel those pushed the buttons off-screen. -->
            <DockPanel LastChildFill="True">
                <TextBlock Text="Fill form" DockPanel.Dock="Left" Foreground="{DynamicResource AccentTextBrush}" FontWeight="Bold"
                           VerticalAlignment="Center" Margin="0,0,10,0" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="New text field…" Click="NewField_Click" Padding="8,3"
                            ToolTip="Create a new AcroForm text field on this page (with required/max-length validation)" />
                    <Separator Margin="6,0" Width="1" Background="{DynamicResource EdgeStrongBrush}" />
                    <Button Content="Flatten form…" Click="Flatten_Click" Padding="8,3"
                            ToolTip="Bake every field value into static page content (fields stop being interactive)" />
                </StackPanel>
                <TextBlock x:Name="HintText" Text="Set a field value; values appear on the page at once."
                           Foreground="{DynamicResource ContentMutedBrush}" VerticalAlignment="Center" Margin="0,0,10,0"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                           AutomationProperties.LiveSetting="Polite" />
            </DockPanel>
        </Border>

        <!-- A DockPanel, not a Grid: DockPanel.Dock is an attached property that
             only means anything when the direct parent is a DockPanel. With a Grid
             here it was silently ignored, so the fields panel and the page were
             both laid out in the same single cell and the page - declared second,
             so drawn on top - hid the panel completely. -->
        <DockPanel LastChildFill="True">
            <!-- Right: fields panel -->
            <DockPanel DockPanel.Dock="Right" Width="300" Margin="4">
                <Border DockPanel.Dock="Top" Background="{DynamicResource SurfaceRaisedBrush}" Padding="6,4">
                    <TextBlock Text="Fields on this page" Foreground="{DynamicResource ContentBrush}" FontWeight="Bold" />
                </Border>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{DynamicResource SurfaceAppBrush}">
                    <Grid>
                        <!-- The interactive field cards, bound. These were the last
                             controls in the shell still assembled in code: a Border,
                             two TextBlocks and either a CheckBox or a TextBox plus a
                             Button per field, with handlers attached by hand. Unlike
                             the outlines drawn over the page, a card carries a live
                             value and writes it back, so it needed a view model with
                             a value and a command rather than a rectangle. -->
                        <ItemsControl x:Name="FieldsPanel"
                                      ItemsSource="{Binding FieldCards, RelativeSource={RelativeSource AncestorType=UserControl}}">
                            <!-- Name the list ITEM, not only the controls inside it.
                                 Binding a collection makes each item a real UIA
                                 DataItem inside a List - the structure the WCAG
                                 assessment wanted - but an unnamed item falls back
                                 to ToString() on the view model, so a screen reader
                                 announced every field as
                                 "PageForge.App.Wpf.ViewModels.FormFieldCardViewModel".
                                 Read out of the UIA tree, not assumed. -->
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="4" Padding="6" BorderThickness="1"
                                            Background="{DynamicResource SurfaceRaisedBrush}"
                                            BorderBrush="{DynamicResource EdgeBrush}"
                                            AutomationProperties.Name="{Binding AccessibleName}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Label}" FontWeight="SemiBold"
                                                       TextWrapping="Wrap"
                                                       Foreground="{DynamicResource ContentBrush}" />
                                            <TextBlock Text="{Binding KindLabel}" FontSize="10"
                                                       Margin="0,0,0,4"
                                                       Foreground="{DynamicResource ContentMutedBrush}" />

                                            <!-- A checkbox commits on toggle; a text field
                                                 commits on Set, because rewriting the PDF
                                                 on every keystroke is not an edit model. -->
                                            <CheckBox Content="Checked"
                                                      IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                      VerticalAlignment="Center"
                                                      AutomationProperties.Name="{Binding Label}"
                                                      Visibility="{Binding IsCheckable, Converter={StaticResource BoolToVis}}" />

                                            <StackPanel Orientation="Horizontal"
                                                        Visibility="{Binding IsCheckable, Converter={StaticResource NotBoolToVis}}">
                                                <TextBox Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         Width="150" Margin="0,0,6,0"
                                                         VerticalContentAlignment="Center"
                                                         AutomationProperties.Name="{Binding ValueAccessibleName}" />
                                                <Button Content="Set" Padding="8,2"
                                                        Command="{Binding SetCommand}"
                                                        AutomationProperties.Name="{Binding SetAccessibleName}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Shown only when the page has no fields, bound to the count
                             so no code path can leave it behind - the same reason the
                             redaction panel's empty state is bound rather than added
                             and removed by hand. -->
                        <TextBlock x:Name="NoFieldsText" Margin="8" TextWrapping="Wrap"
                                   Foreground="{DynamicResource ContentMutedBrush}"
                                   Text="{Binding EmptyStateText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                   Visibility="{Binding FieldCards.Count, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource ZeroToVis}}" />
                    </Grid>
                </ScrollViewer>
            </DockPanel>

            <!-- Left: page + overlay -->
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                          Background="{DynamicResource CanvasBrush}">
                <Grid x:Name="PageHost" Background="White" Margin="24">
                    <Image x:Name="PageImage" Stretch="None" SnapsToDevicePixels="True"
                       AutomationProperties.Name="Form fill page" />
                    <!-- Field outlines, bound. Same shape as the redaction overlay:
                         one collection, one template, and the PDF-to-screen
                         conversion shared through PageBoxGeometry. -->
                    <ItemsControl ItemsSource="{Binding FieldBoxes, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  IsHitTestVisible="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas ClipToBounds="True" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Canvas.Left" Value="{Binding Left}" />
                                <Setter Property="Canvas.Top" Value="{Binding Top}" />
                                <!-- Without this the item announces ToString() on the view model, i.e. the class name. -->
                                <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Rectangle Width="{Binding Width}" Height="{Binding Height}"
                                           Fill="#0C2B8CFF" Stroke="#FF1F74C6" StrokeThickness="1"
                                           AutomationProperties.Name="{Binding AccessibleName}">
                                    <Rectangle.StrokeDashArray>
                                        <DoubleCollection>3 2</DoubleCollection>
                                    </Rectangle.StrokeDashArray>
                                </Rectangle>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Canvas x:Name="Overlay" IsHitTestVisible="False" ClipToBounds="True" Focusable="True" />
                </Grid>
            </ScrollViewer>
        </DockPanel>
    </DockPanel>
</UserControl>
