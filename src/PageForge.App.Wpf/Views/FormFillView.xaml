<UserControl x:Class="PageForge.App.Wpf.Views.FormFillView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <DockPanel Background="#3a3a3a">
        <!-- Form-fill toolbar -->
        <Border DockPanel.Dock="Top" Background="#2b2b2b" Padding="6,4">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Fill form" Foreground="#9df" FontWeight="Bold"
                           VerticalAlignment="Center" Margin="0,0,10,0" />
                <TextBlock x:Name="HintText" Text="Set a field value; values appear on the page at once."
                           Foreground="#bbb" VerticalAlignment="Center" Margin="0,0,10,0" />
                <Separator Margin="6,0" Width="1" Background="#555" />
                <Button Content="Flatten form…" Click="Flatten_Click" Padding="8,3"
                        ToolTip="Bake every field value into static page content (fields stop being interactive)" />
            </StackPanel>
        </Border>

        <Grid>
            <!-- Right: fields panel -->
            <DockPanel DockPanel.Dock="Right" Width="300" Margin="4">
                <Border DockPanel.Dock="Top" Background="#2b2b2b" Padding="6,4">
                    <TextBlock Text="Fields on this page" Foreground="#ddd" FontWeight="Bold" />
                </Border>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Background="#252525">
                    <StackPanel x:Name="FieldsPanel" />
                </ScrollViewer>
            </DockPanel>

            <!-- Left: page + overlay -->
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                          Background="#3a3a3a">
                <Grid x:Name="PageHost" Background="White" Margin="24">
                    <Image x:Name="PageImage" Stretch="None" SnapsToDevicePixels="True" />
                    <Canvas x:Name="Overlay" IsHitTestVisible="False" ClipToBounds="True" />
                </Grid>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</UserControl>
