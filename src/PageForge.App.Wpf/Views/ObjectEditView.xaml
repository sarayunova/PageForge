<UserControl x:Class="PageForge.App.Wpf.Views.ObjectEditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <DockPanel Background="{DynamicResource CanvasBrush}">
        <!-- Object-edit toolbar -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource SurfaceRaisedBrush}" Padding="6,4">
            <!-- Commands dock right, hint takes what is left: a long hint must
                 never push a button off the edge of the window. -->
            <DockPanel LastChildFill="True">
                <TextBlock Text="Object edit" DockPanel.Dock="Left" Foreground="{DynamicResource AccentTextBrush}" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Replace…" Click="Replace_Click" x:Name="ReplaceButton" Padding="8,3"
                            IsEnabled="False" ToolTip="Pick a PNG/JPEG to paint inside the selected object's box" />
                    <Separator Margin="6,0" Width="1" Background="{DynamicResource EdgeStrongBrush}" />
                    <Button Content="↩ Undo" Click="Undo_Click" x:Name="UndoButton" Padding="8,3" />
                    <Button Content="↪ Redo" Click="Redo_Click" x:Name="RedoButton" Padding="8,3" />
                </StackPanel>
                <TextBlock x:Name="HintText" Text="Click an object to select; drag to move; drag a handle to resize. Keyboard: Tab selects, arrows move, Ctrl+arrows resize, Enter commits."
                           Foreground="{DynamicResource ContentMutedBrush}" VerticalAlignment="Center" Margin="0,0,10,0"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                           AutomationProperties.LiveSetting="Polite" />
            </DockPanel>
        </Border>

        <!-- Page + overlay -->
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="{DynamicResource CanvasBrush}">
            <Grid x:Name="PageHost" Background="White" Margin="24">
                <Image x:Name="PageImage" Stretch="None" SnapsToDevicePixels="True"
                       AutomationProperties.Name="Object edit page" />

                <!-- The object boxes, bound. Their own layer beneath Overlay, which
                     keeps its Canvas for the selection handles: those are transient
                     view state belonging to whichever box is selected rather than
                     items in their own right, the same split the redaction surface
                     makes to keep its rubber band out of its collection. Not
                     hit-testable: Overlay owns the mouse. -->
                <ItemsControl ItemsSource="{Binding Boxes, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              IsHitTestVisible="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas ClipToBounds="True" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Canvas.Left" Value="{Binding Left}" />
                            <Setter Property="Canvas.Top" Value="{Binding Top}" />
                            <!-- Without this the item announces ToString() on the view model, i.e. the class name. -->
                            <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!-- WCAG 1.4.11: both strokes clear 3:1 on white -
                                 unselected #1F74C6 ~4.8:1, selected #2B8CFF ~3.3:1. -->
                            <Rectangle Width="{Binding Width}" Height="{Binding Height}"
                                       AutomationProperties.Name="{Binding AccessibleName}">
                                <Rectangle.Style>
                                    <Style TargetType="Rectangle">
                                        <Setter Property="Fill" Value="#102B8CFF" />
                                        <Setter Property="Stroke" Value="#FF1F74C6" />
                                        <Setter Property="StrokeThickness" Value="1" />
                                        <Setter Property="StrokeDashArray" Value="3 2" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="Fill" Value="#222B8CFF" />
                                                <Setter Property="Stroke" Value="#FF2B8CFF" />
                                                <Setter Property="StrokeThickness" Value="2" />
                                                <Setter Property="StrokeDashArray" Value="{x:Null}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Rectangle.Style>
                            </Rectangle>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Background is load-bearing, not styling. IsHitTestVisible is
                     not enough on its own: a Panel whose Background is null has
                     nothing to hit, so every press fell through to the page image
                     and select, move and resize - the whole mouse story for
                     FR-EDIT - never ran. The redaction surface had the identical
                     defect. Transparent paints nothing and hit-tests everywhere. -->
                <Canvas x:Name="Overlay" Background="Transparent" IsHitTestVisible="True"
                        ClipToBounds="True" Focusable="True" />
            </Grid>
        </ScrollViewer>
    </DockPanel>
</UserControl>
