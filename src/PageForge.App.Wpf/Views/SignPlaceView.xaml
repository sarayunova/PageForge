<UserControl x:Class="PageForge.App.Wpf.Views.SignPlaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Background="{DynamicResource CanvasBrush}">
        <!-- Placement toolbar. The commands dock right and the hint takes what is
             left, so a long hint can never push a button off the window edge -
             the overflow the main and redact toolbars both had to fix. -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource SurfaceRaisedBrush}" Padding="6,4">
            <DockPanel LastChildFill="True">
                <TextBlock Text="Place signature" DockPanel.Dock="Left" FontWeight="Bold"
                           Foreground="{DynamicResource ContentBrush}"
                           VerticalAlignment="Center" Margin="0,0,10,0" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="PrevPageButton" Content="◀ Page" Padding="8,3"
                            AutomationProperties.Name="Previous page" Click="PrevPage_Click"
                            ToolTip="Place the signature on the previous page" />
                    <TextBlock x:Name="PageText" VerticalAlignment="Center" Margin="8,0"
                               Foreground="{DynamicResource ContentBrush}"
                               AutomationProperties.LiveSetting="Polite" />
                    <Button x:Name="NextPageButton" Content="Page ▶" Padding="8,3"
                            AutomationProperties.Name="Next page" Click="NextPage_Click"
                            ToolTip="Place the signature on the next page" />
                    <Separator Margin="6,0" Width="1" Background="{DynamicResource EdgeStrongBrush}" />
                    <Button Content="Use the default box" Padding="8,3"
                            AutomationProperties.Name="Use the default signature box"
                            Click="UseDefault_Click"
                            ToolTip="Skip placing it: put the signature in the standard box near the bottom-left of this page" />
                    <Button x:Name="ContinueButton" Content="Continue…" Padding="10,3" Margin="6,0,0,0"
                            IsEnabled="False" AutomationProperties.Name="Continue to signing"
                            Click="Continue_Click"
                            ToolTip="Sign with the box placed on this page" />
                    <Button Content="Cancel" Padding="8,3" Margin="6,0,0,0"
                            AutomationProperties.Name="Cancel signing" Click="Cancel_Click" />
                </StackPanel>
                <TextBlock x:Name="HintText" VerticalAlignment="Center" Margin="0,0,10,0"
                           Foreground="{DynamicResource ContentMutedBrush}"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                           AutomationProperties.LiveSetting="Polite"
                           Text="Drag a box where the signature should appear, or use the keyboard: Enter begins a box, arrows size it, Ctrl+arrows move it, Enter places it, Esc cancels." />
            </DockPanel>
        </Border>

        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                      Background="{DynamicResource CanvasBrush}">
            <Grid x:Name="PageHost" Background="White" Margin="24">
                <Image x:Name="PageImage" Stretch="None" SnapsToDevicePixels="True"
                       AutomationProperties.Name="Page to sign" />

                <Canvas x:Name="Overlay" ClipToBounds="True" Focusable="True"
                        MouseLeftButtonDown="Overlay_MouseLeftButtonDown"
                        MouseMove="Overlay_MouseMove"
                        MouseLeftButtonUp="Overlay_MouseLeftButtonUp"
                        AutomationProperties.Name="Signature placement surface"
                        Cursor="Cross" />
            </Grid>
        </ScrollViewer>
    </DockPanel>
</UserControl>
