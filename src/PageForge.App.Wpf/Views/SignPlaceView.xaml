<UserControl x:Class="PageForge.App.Wpf.Views.SignPlaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:PageForge.App.Wpf.Resources">
    <DockPanel Background="{DynamicResource CanvasBrush}">
        <!-- Placement toolbar. The commands dock right and the hint takes what is
             left, so a long hint can never push a button off the window edge -
             the overflow the main and redact toolbars both had to fix. -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource SurfaceRaisedBrush}" Padding="6,4">
            <DockPanel LastChildFill="True">
                <TextBlock Text="{loc:Str SignPlace_PlaceSignature_Text}" DockPanel.Dock="Left" FontWeight="Bold"
                           Foreground="{DynamicResource ContentBrush}"
                           VerticalAlignment="Center" Margin="0,0,10,0" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="PrevPageButton" Content="{loc:Str SignPlace_Page}" Padding="8,3"
                            AutomationProperties.Name="{loc:Str SignPlace_PreviousPage_Name}" Click="PrevPage_Click"
                            ToolTip="{loc:Str SignPlace_PlaceTheSignatureOnThe_Tip}" />
                    <TextBlock x:Name="PageText" VerticalAlignment="Center" Margin="8,0"
                               Foreground="{DynamicResource ContentBrush}"
                               AutomationProperties.LiveSetting="Polite" />
                    <Button x:Name="NextPageButton" Content="{loc:Str SignPlace_Page2}" Padding="8,3"
                            AutomationProperties.Name="{loc:Str SignPlace_NextPage_Name}" Click="NextPage_Click"
                            ToolTip="{loc:Str SignPlace_PlaceTheSignatureOnThe_Tip2}" />
                    <Separator Margin="6,0" Width="1" Background="{DynamicResource EdgeStrongBrush}" />
                    <Button Content="{loc:Str SignPlace_UseTheDefaultBox}" Padding="8,3"
                            AutomationProperties.Name="{loc:Str SignPlace_UseTheDefaultSignatureBox_Name}"
                            Click="UseDefault_Click"
                            ToolTip="{loc:Str SignPlace_SkipPlacingItPutThe_Tip}" />
                    <Button x:Name="ContinueButton" Content="{loc:Str SignPlace_Continue}" Padding="10,3" Margin="6,0,0,0"
                            IsEnabled="False" AutomationProperties.Name="{loc:Str SignPlace_ContinueToSigning_Name}"
                            Click="Continue_Click"
                            ToolTip="{loc:Str SignPlace_SignWithTheBoxPlaced_Tip}" />
                    <Button Content="{loc:Str SignPlace_Cancel}" Padding="8,3" Margin="6,0,0,0"
                            AutomationProperties.Name="{loc:Str SignPlace_CancelSigning_Name}" Click="Cancel_Click" />
                </StackPanel>
                <!-- The automation id is load-bearing: the UI suite drives a real
                     mouse drag across the overlay and reads the placed box's
                     coordinates back from here, which is how the screen-to-PDF
                     flip is checked through the actual gesture. -->
                <TextBlock x:Name="HintText" AutomationProperties.AutomationId="SignPlaceHint"
                           VerticalAlignment="Center" Margin="0,0,10,0"
                           Foreground="{DynamicResource ContentMutedBrush}"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                           AutomationProperties.LiveSetting="Polite"
                           Text="{loc:Str SignPlace_DragABoxWhereThe_Text}" />
            </DockPanel>
        </Border>

        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                      Background="{DynamicResource CanvasBrush}">
            <Grid x:Name="PageHost" Background="White" Margin="24">
                <Image x:Name="PageImage" Stretch="None" SnapsToDevicePixels="True"
                       AutomationProperties.Name="{loc:Str SignPlace_PageToSign_Name}" />

                <!-- Background is load-bearing, not styling: a Panel whose
                     Background is null is invisible to hit testing, so an
                     overlay without one never receives the mouse and the drag
                     goes to whatever is behind it. Transparent paints nothing
                     and hit-tests everywhere. -->
                <Canvas x:Name="Overlay" Background="Transparent" ClipToBounds="True" Focusable="True"
                        MouseLeftButtonDown="Overlay_MouseLeftButtonDown"
                        MouseMove="Overlay_MouseMove"
                        MouseLeftButtonUp="Overlay_MouseLeftButtonUp"
                        AutomationProperties.Name="{loc:Str SignPlace_SignaturePlacementSurface_Name}"
                        Cursor="Cross" />
            </Grid>
        </ScrollViewer>
    </DockPanel>
</UserControl>
