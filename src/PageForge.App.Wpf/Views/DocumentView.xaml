<UserControl x:Class="PageForge.App.Wpf.Views.DocumentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:PageForge.App.Wpf.ViewModels"
             xmlns:locals="clr-namespace:PageForge.App.Wpf.Views"
             xmlns:controls="clr-namespace:PageForge.App.Wpf.Controls"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <UserControl.Resources>
        <locals:RotationToTransformConverter x:Key="RotationToTransform" />
        <locals:ZoomPercentConverter x:Key="ZoomPercent" />
        <locals:IndentToWidthConverter x:Key="IndentToWidth" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <DockPanel>
        <!--
            Top chrome, in three rows.

            This used to be a single horizontal StackPanel holding roughly thirty
            controls: navigation, zoom, rotation, and every Organize / Annotate /
            Edit / Forms / Redact tool at once. It ran off the right edge of the
            window with no overflow handling, so the last commands were simply
            unreachable below about 1500px, and it offered no hierarchy - every
            mode shouted equally.

            Now: row 1 is the always-available command bar (bypass, page
            navigation, zoom, rotation, view mode, undo/redo, search); row 2 is a
            tool-group selector; row 3 shows only the selected group's commands.
            The mode TOGGLES inside each group are unchanged - same names, same
            handlers - so selecting a group only decides what is on screen, not
            what the editor is doing.

            The group selector uses RadioButtons sharing a GroupName so the mutual
            exclusion is real rather than hand-maintained, and so UIA and the
            keyboard get correct radio-group semantics for free.
        -->
        <StackPanel DockPanel.Dock="Top">

            <!-- Row 1: always-available commands. -->
            <Border Background="{DynamicResource SurfaceRaisedBrush}"
                    BorderBrush="{DynamicResource EdgeBrush}" BorderThickness="0,0,0,1"
                    Padding="8,5">
                <DockPanel LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                        <ToggleButton x:Name="SidebarToggle" IsChecked="True"
                                      AutomationProperties.Name="Show the sidebar"
                                      Checked="SidebarToggle_Changed" Unchecked="SidebarToggle_Changed"
                                      Padding="8,3" Margin="0,0,8,0"
                                      ToolTip="Hide or show the thumbnails, bookmarks, search and annotations panel">
                            <ui:SymbolIcon Symbol="PanelLeft24" FontSize="14" />
                        </ToggleButton>
                        <Button x:Name="SkipToPageButton"
                                AutomationProperties.Name="Skip to the document"
                                Click="SkipToPage_Click" Padding="10,3"
                                ToolTip="Move keyboard focus to the document surface (WCAG 2.4.1 bypass)">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="ArrowExportUp24" FontSize="14" Margin="0,0,6,0" />
                                <TextBlock Text="Skip to page" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Separator Margin="8,0" Width="1" Background="{DynamicResource EdgeStrongBrush}" />

                        <Button AutomationProperties.Name="Previous page" Command="{Binding PreviousPageCommand}"
                                Padding="8,3" ToolTip="Previous page">
                            <ui:SymbolIcon Symbol="ArrowLeft24" FontSize="14" />
                        </Button>
                        <TextBlock x:Name="PageIndicatorText" Text="{Binding PageIndicator}" Foreground="{DynamicResource ContentBrush}"
                                   VerticalAlignment="Center" Margin="10,0" MinWidth="70" TextAlignment="Center" />
                        <Button x:Name="NextButton" AutomationProperties.Name="Next page" Command="{Binding NextPageCommand}"
                                Padding="8,3" ToolTip="Next page">
                            <ui:SymbolIcon Symbol="ArrowRight24" FontSize="14" />
                        </Button>
                        <Separator Margin="8,0" Width="1" Background="{DynamicResource EdgeStrongBrush}" />

                        <Button AutomationProperties.Name="Zoom out" Command="{Binding ZoomOutCommand}"
                                Padding="8,3" ToolTip="Zoom out">
                            <ui:SymbolIcon Symbol="ZoomOut24" FontSize="14" />
                        </Button>
                        <TextBlock x:Name="ZoomText" Text="{Binding Zoom, Converter={StaticResource ZoomPercent}}" Foreground="{DynamicResource ContentBrush}"
                                   VerticalAlignment="Center" Margin="8,0" MinWidth="46" TextAlignment="Center" />
                        <Button AutomationProperties.Name="Zoom in" Command="{Binding ZoomInCommand}"
                                Padding="8,3" ToolTip="Zoom in">
                            <ui:SymbolIcon Symbol="ZoomIn24" FontSize="14" />
                        </Button>
                        <Button AutomationProperties.Name="Reset zoom to 100%" Command="{Binding ZoomResetCommand}"
                                Padding="8,3" ToolTip="Reset zoom to 100%">
                            <ui:SymbolIcon Symbol="ArrowMaximize24" FontSize="14" />
                        </Button>
                        <Separator Margin="8,0" Width="1" Background="{DynamicResource EdgeStrongBrush}" />

                        <Button AutomationProperties.Name="Rotate counter-clockwise" Command="{Binding RotateCounterClockwiseCommand}"
                                Padding="8,3" ToolTip="Rotate the view counter-clockwise">
                            <ui:SymbolIcon Symbol="ArrowRotateCounterclockwise24" FontSize="14" />
                        </Button>
                        <Button AutomationProperties.Name="Rotate clockwise" Command="{Binding RotateClockwiseCommand}"
                                Padding="8,3" ToolTip="Rotate the view clockwise">
                            <ui:SymbolIcon Symbol="ArrowRotateClockwise24" FontSize="14" />
                        </Button>
                        <Separator Margin="8,0" Width="1" Background="{DynamicResource EdgeStrongBrush}" />

                        <ToggleButton x:Name="ContinuousToggle" Content="Continuous"
                                      AutomationProperties.Name="Continuous scroll mode"
                                      Checked="ContinuousToggle_Changed"
                                      Unchecked="ContinuousToggle_Changed" Padding="10,3"
                                      ToolTip="Scroll all pages continuously instead of one at a time" />
                        <Separator Margin="8,0" Width="1" Background="{DynamicResource EdgeStrongBrush}" />

                        <!-- Undo/redo are document-wide, not tool-specific, so they
                             stay reachable whichever group is selected. -->
                        <Button AutomationProperties.Name="Undo" Click="EditUndo_Click"
                                Padding="8,3" ToolTip="Undo last edit (Ctrl+Z)">
                            <ui:SymbolIcon Symbol="ArrowUndo24" FontSize="14" />
                        </Button>
                        <Button AutomationProperties.Name="Redo" Click="EditRedo_Click"
                                Padding="8,3" ToolTip="Redo last undone edit (Ctrl+Y)">
                            <ui:SymbolIcon Symbol="ArrowRedo24" FontSize="14" />
                        </Button>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBox x:Name="SearchBox" AutomationProperties.Name="Search document text"
                                 Width="200" KeyDown="SearchBox_KeyDown" VerticalAlignment="Center" />
                        <Button AutomationProperties.Name="Search" Click="Search_Click"
                                Padding="8,3" Margin="6,0,0,0" ToolTip="Search the document text">
                            <ui:SymbolIcon Symbol="Search24" FontSize="14" />
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Row 2: tool-group selector. -->
            <Border Background="{DynamicResource SurfacePanelBrush}"
                    BorderBrush="{DynamicResource EdgeBrush}" BorderThickness="0,0,0,1"
                    Padding="8,0">
                <StackPanel Orientation="Horizontal" AutomationProperties.Name="Tool groups">
                    <RadioButton x:Name="OrganizeModeTab" GroupName="ToolGroup" IsChecked="True"
                                 Style="{StaticResource ToolGroupTabStyle}"
                                 AutomationProperties.Name="Organize tool group"
                                 Checked="ToolGroupTab_Checked" Content="Organize" />
                    <RadioButton x:Name="AnnotateModeTab" GroupName="ToolGroup"
                                 Style="{StaticResource ToolGroupTabStyle}"
                                 AutomationProperties.Name="Annotate tool group"
                                 Checked="ToolGroupTab_Checked" Content="Annotate" />
                    <RadioButton x:Name="EditModeTab" GroupName="ToolGroup"
                                 Style="{StaticResource ToolGroupTabStyle}"
                                 AutomationProperties.Name="Edit tool group"
                                 Checked="ToolGroupTab_Checked" Content="Edit" />
                    <RadioButton x:Name="FormsModeTab" GroupName="ToolGroup"
                                 Style="{StaticResource ToolGroupTabStyle}"
                                 AutomationProperties.Name="Form tool group"
                                 Checked="ToolGroupTab_Checked" Content="Forms" />
                    <RadioButton x:Name="RedactModeTab" GroupName="ToolGroup"
                                 Style="{StaticResource ToolGroupTabStyle}"
                                 AutomationProperties.Name="Redact tool group"
                                 Checked="ToolGroupTab_Checked" Content="Redact" />
                    <RadioButton x:Name="DocumentModeTab" GroupName="ToolGroup"
                                 Style="{StaticResource ToolGroupTabStyle}"
                                 AutomationProperties.Name="Document tool group"
                                 Checked="ToolGroupTab_Checked" Content="Document" />
                </StackPanel>
            </Border>

            <!-- Row 3: the selected group's commands. Exactly one child is visible;
                 ToolGroupTab_Checked does the swapping. -->
            <Border Background="{DynamicResource SurfaceRaisedBrush}"
                    BorderBrush="{DynamicResource EdgeBrush}" BorderThickness="0,0,0,1"
                    Padding="8,5" MinHeight="38">
                <Grid>
                    <StackPanel x:Name="OrganizeGroup" Orientation="Horizontal" VerticalAlignment="Center">
                        <controls:HeadingTextBlock Text="Organize" HeadingLevel="2"
                                                   Foreground="{DynamicResource ContentMutedBrush}"
                                                   VerticalAlignment="Center" Margin="0,0,10,0"
                                                   AutomationProperties.Name="Organize tools" />
                        <Button AutomationProperties.Name="Rotate page" Click="OrganizeRotatePage_Click"
                                Padding="10,3" Margin="0,0,4,0"
                                ToolTip="Save a rotated copy of the current page to a new file">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="ArrowRotateClockwise24" FontSize="14" Margin="0,0,6,0" />
                                <TextBlock Text="Rotate page" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button AutomationProperties.Name="Delete page" Click="OrganizeDeletePage_Click"
                                Padding="10,3" Margin="0,0,4,0"
                                ToolTip="Delete the current page into a new file">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Delete24" FontSize="14" Margin="0,0,6,0" />
                                <TextBlock Text="Delete page" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button AutomationProperties.Name="Extract page" Click="OrganizeExtractPage_Click"
                                Padding="10,3" Margin="0,0,4,0"
                                ToolTip="Extract the current page to a new file">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Cut24" FontSize="14" Margin="0,0,6,0" />
                                <TextBlock Text="Extract page" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button AutomationProperties.Name="Insert page" Click="OrganizeInsert_Click"
                                Padding="10,3" Margin="0,0,4,0"
                                ToolTip="Insert another PDF before/after the current page">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="DocumentAdd24" FontSize="14" Margin="0,0,6,0" />
                                <TextBlock Text="Insert…" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Separator Margin="8,0" Width="1" Background="{DynamicResource EdgeStrongBrush}" />
                        <ToggleButton x:Name="ReorderToggle" AutomationProperties.Name="Reorder pages"
                                      Checked="ReorderToggle_Changed" Unchecked="ReorderToggle_Changed"
                                      Padding="10,3" Margin="0,0,4,0"
                                      ToolTip="Drag thumbnails to reorder pages, then save">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="ReOrder24" FontSize="14" Margin="0,0,6,0" />
                                <TextBlock Text="Reorder" VerticalAlignment="Center" />
                            </StackPanel>
                        </ToggleButton>
                        <Button x:Name="SaveOrderButton" AutomationProperties.Name="Save page order"
                                Click="SaveOrder_Click" Padding="10,3"
                                ToolTip="Write the reordered pages to a new PDF">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Save24" FontSize="14" Margin="0,0,6,0" />
                                <TextBlock Text="Save order…" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <StackPanel x:Name="AnnotateGroup" Orientation="Horizontal" VerticalAlignment="Center"
                                Visibility="Collapsed">
                        <controls:HeadingTextBlock Text="Annotate" HeadingLevel="2"
                                                   Foreground="{DynamicResource ContentMutedBrush}"
                                                   VerticalAlignment="Center" Margin="0,0,10,0"
                                                   AutomationProperties.Name="Annotate tools" />
                        <Button AutomationProperties.Name="Add highlight" Click="AnnotateHighlight_Click"
                                Padding="10,3" Margin="0,0,4,0"
                                ToolTip="Add a highlight over the top of the current page">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Highlight24" FontSize="14" Margin="0,0,6,0"
                                               Foreground="{DynamicResource AnnotationHighlightBrush}" />
                                <TextBlock Text="Highlight" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button AutomationProperties.Name="Add text note" Click="AnnotateText_Click"
                                Padding="10,3" Margin="0,0,4,0"
                                ToolTip="Add a text note to the current page">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Comment24" FontSize="14" Margin="0,0,6,0"
                                               Foreground="{DynamicResource AnnotationNoteBrush}" />
                                <TextBlock Text="Note" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button AutomationProperties.Name="Add ink stroke" Click="AnnotateInk_Click"
                                Padding="10,3" Margin="0,0,4,0"
                                ToolTip="Add an ink stroke to the current page">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="InkingTool24" FontSize="14" Margin="0,0,6,0"
                                               Foreground="{DynamicResource AnnotationInkBrush}" />
                                <TextBlock Text="Ink" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Separator Margin="8,0" Width="1" Background="{DynamicResource EdgeStrongBrush}" />
                        <Button AutomationProperties.Name="Flatten annotations" Click="AnnotateFlatten_Click"
                                Padding="10,3"
                                ToolTip="Save a copy with selected annotation types baked into static content">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Layer24" FontSize="14" Margin="0,0,6,0" />
                                <TextBlock Text="Flatten…" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <StackPanel x:Name="EditGroup" Orientation="Horizontal" VerticalAlignment="Center"
                                Visibility="Collapsed">
                        <controls:HeadingTextBlock Text="Edit" HeadingLevel="2"
                                                   Foreground="{DynamicResource ContentMutedBrush}"
                                                   VerticalAlignment="Center" Margin="0,0,10,0"
                                                   AutomationProperties.Name="Edit tools" />
                        <ToggleButton x:Name="EditModeToggle" AutomationProperties.Name="Edit text mode"
                                      Checked="EditModeToggle_Changed" Unchecked="EditModeToggle_Changed"
                                      Padding="10,3" Margin="0,0,4,0"
                                      ToolTip="Click a word on the page to edit it; edits grow the box and warn on collision">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="TextT24" FontSize="14" Margin="0,0,6,0" />
                                <TextBlock Text="Edit text" VerticalAlignment="Center" />
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton x:Name="ObjectModeToggle" AutomationProperties.Name="Object editing mode"
                                      Checked="ObjectModeToggle_Changed" Unchecked="ObjectModeToggle_Changed"
                                      Padding="10,3"
                                      ToolTip="Select, move, resize, or replace image/vector objects on the page">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Shapes24" FontSize="14" Margin="0,0,6,0" />
                                <TextBlock Text="Edit objects" VerticalAlignment="Center" />
                            </StackPanel>
                        </ToggleButton>
                    </StackPanel>

                    <StackPanel x:Name="FormsGroup" Orientation="Horizontal" VerticalAlignment="Center"
                                Visibility="Collapsed">
                        <controls:HeadingTextBlock Text="Forms" HeadingLevel="2"
                                                   Foreground="{DynamicResource ContentMutedBrush}"
                                                   VerticalAlignment="Center" Margin="0,0,10,0"
                                                   AutomationProperties.Name="Form tools" />
                        <ToggleButton x:Name="FormModeToggle" AutomationProperties.Name="Form fill mode"
                                      Checked="FormModeToggle_Changed" Unchecked="FormModeToggle_Changed"
                                      Padding="10,3"
                                      ToolTip="Fill AcroForm fields on the page, then flatten the form to static content">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Checkbox124" FontSize="14" Margin="0,0,6,0" />
                                <TextBlock Text="Fill form" VerticalAlignment="Center" />
                            </StackPanel>
                        </ToggleButton>
                    </StackPanel>

                    <StackPanel x:Name="RedactGroup" Orientation="Horizontal" VerticalAlignment="Center"
                                Visibility="Collapsed">
                        <controls:HeadingTextBlock Text="Redact" HeadingLevel="2"
                                                   Foreground="{DynamicResource ContentMutedBrush}"
                                                   VerticalAlignment="Center" Margin="0,0,10,0"
                                                   AutomationProperties.Name="Redact tools" />
                        <ToggleButton x:Name="RedactModeToggle" AutomationProperties.Name="Redact mode"
                                      Checked="RedactModeToggle_Changed" Unchecked="RedactModeToggle_Changed"
                                      Padding="10,3"
                                      ToolTip="Drag boxes over sensitive content; apply removes it and paints black (undoable)">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Eraser24" FontSize="14" Margin="0,0,6,0"
                                               Foreground="{DynamicResource DangerBrush}" />
                                <TextBlock Text="Redact" VerticalAlignment="Center" />
                            </StackPanel>
                        </ToggleButton>
                    </StackPanel>

                    <StackPanel x:Name="DocumentGroup" Orientation="Horizontal" VerticalAlignment="Center"
                                Visibility="Collapsed">
                        <controls:HeadingTextBlock Text="Document" HeadingLevel="2"
                                                   Foreground="{DynamicResource ContentMutedBrush}"
                                                   VerticalAlignment="Center" Margin="0,0,10,0"
                                                   AutomationProperties.Name="Document tools" />
                        <Button AutomationProperties.Name="Run OCR" Click="Ocr_Click"
                                Padding="10,3" Margin="0,0,4,0"
                                ToolTip="Render a searchable copy: recognize the document's text offline and embed it (FR-OCR-01)">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="ScanText24" FontSize="14" Margin="0,0,6,0" />
                                <TextBlock Text="OCR…" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button AutomationProperties.Name="Protect document" Click="Protect_Click"
                                Padding="10,3"
                                ToolTip="Write an encrypted copy protected by an open password (FR-SEC-01)">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="LockClosed24" FontSize="14" Margin="0,0,6,0" />
                                <TextBlock Text="Protect…" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>

        <!--
            Sidebar, splitter and page surface share a Grid rather than being
            docked. A fixed 270px sidebar was a Phase U3 gap: a DockPanel offers
            no way to drag the boundary, and the width that suits a thumbnail
            strip is not the width that suits a long outline. The column carries
            the width now, so the splitter and the collapse toggle have exactly
            one thing to change between them.
        -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="270" MinWidth="180" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="320" />
            </Grid.ColumnDefinitions>

        <!-- Left sidebar -->
        <Grid Grid.Column="0" x:Name="Sidebar" Margin="0,4,4,4" Background="{DynamicResource SurfacePanelBrush}">
            <TabControl Background="{DynamicResource SurfacePanelBrush}">
                <TabItem Header="Pages">
                    <ListBox x:Name="ThumbList" ItemsSource="{Binding ThumbnailItems}" Background="{DynamicResource SurfacePanelBrush}" SelectionChanged="ThumbList_SelectionChanged"
                             AllowDrop="True" PreviewMouseLeftButtonDown="ThumbList_PreviewMouseLeftButtonDown"
                             PreviewMouseMove="ThumbList_PreviewMouseMove" Drop="ThumbList_Drop"
                             PreviewKeyDown="ThumbList_PreviewKeyDown"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Vertical" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource EdgeBrush}" BorderThickness="1" Margin="4"
                                        Background="{DynamicResource SurfacePanelBrush}" Cursor="Hand">
                                    <StackPanel>
                                        <Image Source="{Binding Thumbnail.Bitmap}"
                                               Width="160" Height="200" Stretch="Uniform"
                                               AutomationProperties.Name="{Binding AccessibleThumbnailName}"
                                               views:PageImageBehavior.RenderOnLoad="True" />
                                        <TextBlock Text="{Binding DisplayNumber, StringFormat=Page {0}}"
                                                   Foreground="{DynamicResource ContentMutedBrush}" FontSize="12" Margin="4,2" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </TabItem>
                <TabItem Header="Bookmarks">
                    <TreeView x:Name="OutlineTreeView" ItemsSource="{Binding OutlineTree}" Background="{DynamicResource SurfacePanelBrush}"
                              BorderThickness="0"
                              SelectedItemChanged="OutlineTreeView_SelectedItemChanged">
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                    <TextBlock Text="{Binding Title}" Foreground="{DynamicResource ContentBrush}" FontSize="12"
                                               FontWeight="{Binding FontWeightPx}" />
                                    <TextBlock Text="{Binding PageLabel}" Foreground="{DynamicResource ContentMutedBrush}" Margin="8,0,0,0" />
                                </StackPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </TabItem>
                <TabItem Header="Search">
                    <ListBox x:Name="SearchList" ItemsSource="{Binding SearchHits}" Background="{DynamicResource SurfacePanelBrush}" SelectionChanged="SearchList_SelectionChanged"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="2,4">
                                    <TextBlock Foreground="{DynamicResource AccentTextBrush}" FontSize="12"
                                               Text="{Binding PageLabel}" />
                                    <TextBlock Text="{Binding Snippet}" Foreground="{DynamicResource ContentMutedBrush}" FontSize="12"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </TabItem>
                <TabItem Header="Annotations">
                    <DockPanel Background="{DynamicResource SurfacePanelBrush}">
                        <controls:HeadingTextBlock DockPanel.Dock="Top" Text="Annotations on current page" HeadingLevel="3" Foreground="{DynamicResource ContentMutedBrush}" FontSize="12" Margin="4,4,4,2" />
                        <ListBox x:Name="AnnotationList" ItemsSource="{Binding Annotations}" Background="{DynamicResource SurfacePanelBrush}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="2,4">
                                        <TextBlock Foreground="{DynamicResource AccentTextBrush}" FontSize="12"
                                                   Text="{Binding TypeName}" />
                                        <TextBlock Foreground="{DynamicResource ContentMutedBrush}" FontSize="12"
                                                   Text="{Binding Description}" TextWrapping="Wrap" />
                                        <TextBlock Foreground="{DynamicResource ContentMutedBrush}" FontSize="12"
                                                   Text="{Binding Bounds}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </TabItem>
            </TabControl>
        </Grid>

        <!-- Drag handle. Focusable with a keyboard name, because a mouse-only
             way to resize a panel is not a way at all (WCAG 2.1.1). -->
        <GridSplitter x:Name="SidebarSplitter" Grid.Column="1" Width="5" HorizontalAlignment="Stretch"
                      Background="{DynamicResource EdgeBrush}"
                      Focusable="True"
                      AutomationProperties.Name="Resize the sidebar"
                      ToolTip="Drag to resize the sidebar, or focus it and use the arrow keys" />

        <!-- Center: page surface + status -->
        <DockPanel Grid.Column="2">
            <StatusBar DockPanel.Dock="Bottom" Background="{DynamicResource SurfaceRaisedBrush}">
                <ProgressBar Width="110" Height="12" IsIndeterminate="True" Margin="0,0,8,0"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"
                             AutomationProperties.Name="Working" />
                <TextBlock x:Name="StatusText" Text="{Binding Status}" Foreground="{DynamicResource ContentMutedBrush}"
                           AutomationProperties.LiveSetting="Assertive" />
            </StatusBar>
            <Grid>
                <locals:ObjectEditView x:Name="ObjectView" Visibility="Collapsed" />
                <locals:FormFillView x:Name="FormView" Visibility="Collapsed" />
                <locals:RedactView x:Name="RedactViewHost" Visibility="Collapsed" />
                <ListBox x:Name="PageList" ItemsSource="{Binding VisiblePages}" Background="{DynamicResource CanvasBrush}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling"
                     VirtualizingPanel.ScrollUnit="Pixel"
                     ScrollViewer.CanContentScroll="False"
                     PreviewKeyDown="PageList_PreviewKeyDown">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="HorizontalAlignment" Value="Center" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Focusable" Value="True" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="{DynamicResource PageBorderBrush}" BorderThickness="1" Margin="8,10"
                                Background="{DynamicResource PageSheetBrush}"
                                LayoutTransform="{Binding DataContext.Rotation, Converter={StaticResource RotationToTransform}, RelativeSource={RelativeSource AncestorType=ListBox}}">
                            <Grid>
                                <!-- Stretch=None is deliberate and fidelity-critical:
                                     the bitmap shows at exactly the DPI it was
                                     rendered at, so zoom means "re-render sharper",
                                     never "resample a cached bitmap up". -->
                                <Image Source="{Binding Image.Bitmap}" Stretch="None"
                                       CacheMode="BitmapCache"
                                       MouseLeftButtonUp="PageImage_MouseLeftButtonUp"
                                       AutomationProperties.Name="{Binding AccessibleImageName}"
                                       views:PageImageBehavior.RenderOnLoad="True" />
                                <!-- A render that fails must say so on the page
                                     rather than leaving a blank sheet. -->
                                <Border Background="{DynamicResource DangerSurfaceBrush}" Padding="12,8" MinWidth="240"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Visibility="{Binding Image.HasRenderError, Converter={StaticResource BoolToVis}}">
                                    <StackPanel>
                                        <controls:HeadingTextBlock HeadingLevel="3" Foreground="{DynamicResource DangerSurfaceForegroundBrush}"
                                                                   FontWeight="Bold" TextWrapping="Wrap"
                                                                   Text="{Binding DisplayNumber, StringFormat=Page {0} could not be rendered}" />
                                        <TextBlock Foreground="{DynamicResource DangerSurfaceMutedForegroundBrush}" FontSize="12" TextWrapping="Wrap"
                                                   Margin="0,4,0,0"
                                                   AutomationProperties.LiveSetting="Polite"
                                                   Text="{Binding Image.RenderError}" />
                                        <!-- A render can fail for reasons that pass
                                             on a second attempt (a transient file
                                             lock, memory pressure at a high zoom),
                                             so reporting without offering a retry
                                             would strand the page. -->
                                        <Button Content="Try again" Margin="0,8,0,0" Padding="12,4"
                                                HorizontalAlignment="Left"
                                                AutomationProperties.Name="Try rendering this page again"
                                                Click="PageRetryRender_Click" />
                                    </StackPanel>
                                </Border>
                                <Border x:Name="WordHighlight" BorderBrush="{DynamicResource SelectionBrush}"
                                        BorderThickness="2" Visibility="Collapsed"
                                        IsHitTestVisible="False"
                                        HorizontalAlignment="Left" VerticalAlignment="Top" />
                                <TextBlock Text="{Binding AccessibleText}"
                                           IsHitTestVisible="False" Opacity="0"
                                           TextWrapping="Wrap" VerticalAlignment="Stretch"
                                           AutomationProperties.Name="{Binding AccessibleImageName}"
                                           views:PageImageBehavior.EnsureTextOnLoad="True" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            </Grid>
        </DockPanel>
        </Grid>
    </DockPanel>
</UserControl>
