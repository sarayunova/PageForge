<UserControl x:Class="PageForge.App.Wpf.Views.DocumentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:PageForge.App.Wpf.ViewModels"
             xmlns:locals="clr-namespace:PageForge.App.Wpf.Views"
             xmlns:controls="clr-namespace:PageForge.App.Wpf.Controls">
    <UserControl.Resources>
        <locals:RotationToTransformConverter x:Key="RotationToTransform" />
        <locals:ZoomPercentConverter x:Key="ZoomPercent" />
        <locals:IndentToWidthConverter x:Key="IndentToWidth" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <DockPanel>
        <!-- Top toolbar -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource SurfaceRaisedBrush}" Padding="6,4">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="⇩ Skip to page" x:Name="SkipToPageButton"
                        AutomationProperties.Name="Skip to the document"
                        Click="SkipToPage_Click" Padding="8,3"
                        ToolTip="Move keyboard focus to the document surface (WCAG 2.4.1 bypass)" />
                <Separator Margin="6,0" Width="1" Background="{DynamicResource EdgeStrongBrush}" />
                <ToggleButton x:Name="ContinuousToggle" Content="Continuous"
                              AutomationProperties.Name="Continuous scroll mode"
                              Checked="ContinuousToggle_Changed"
                              Unchecked="ContinuousToggle_Changed" Padding="10,3" />
                <Separator Margin="6,0" Width="1" Background="{DynamicResource EdgeStrongBrush}" />
                <Button Content="◀ Prev" AutomationProperties.Name="Previous page"
                        Click="Previous_Click" Padding="8,3" />
                <TextBlock x:Name="PageIndicatorText" Foreground="{DynamicResource ContentBrush}" VerticalAlignment="Center"
                           Margin="10,0" MinWidth="70" TextAlignment="Center" />
                <Button Content="Next ▶" x:Name="NextButton" AutomationProperties.Name="Next page"
                        Click="Next_Click" Padding="8,3" />
                <Separator Margin="6,0" Width="1" Background="{DynamicResource EdgeStrongBrush}" />
                <Button Content="−" AutomationProperties.Name="Zoom out" Click="ZoomOut_Click" Padding="10,3" ToolTip="Zoom out" />
                <TextBlock x:Name="ZoomText" Foreground="{DynamicResource ContentBrush}" VerticalAlignment="Center"
                           Margin="8,0" MinWidth="46" TextAlignment="Center" />
                <Button Content="+" AutomationProperties.Name="Zoom in" Click="ZoomIn_Click" Padding="10,3" ToolTip="Zoom in" />
                <Button Content="Fit" AutomationProperties.Name="Fit to width" Click="ZoomFit_Click" Padding="8,3" ToolTip="Fit width" />
                <Separator Margin="6,0" Width="1" Background="{DynamicResource EdgeStrongBrush}" />
                <Button Content="⟲" AutomationProperties.Name="Rotate counter-clockwise" Click="RotateCCW_Click" Padding="10,3" ToolTip="Rotate counter-clockwise" />
                <Button Content="⟳" AutomationProperties.Name="Rotate clockwise" Click="RotateCW_Click" Padding="10,3" ToolTip="Rotate clockwise" />
                <Separator Margin="6,0" Width="1" Background="{DynamicResource EdgeStrongBrush}" />
                <controls:HeadingTextBlock Text="Organize" HeadingLevel="2" Foreground="{DynamicResource ContentMutedBrush}" VerticalAlignment="Center" Margin="0,0,6,0" AutomationProperties.Name="Organize tools" />
                <Button Content="⟳ page" AutomationProperties.Name="Rotate page" Click="OrganizeRotatePage_Click" Padding="8,3" ToolTip="Save a rotated copy of the current page to a new file" />
                <Button Content="✕ page" AutomationProperties.Name="Delete page" Click="OrganizeDeletePage_Click" Padding="8,3" ToolTip="Delete the current page into a new file" />
                <Button Content="✂ page" AutomationProperties.Name="Extract page" Click="OrganizeExtractPage_Click" Padding="8,3" ToolTip="Extract the current page to a new file" />
                <Button Content="⧉ insert…" AutomationProperties.Name="Insert page" Click="OrganizeInsert_Click" Padding="8,3" ToolTip="Insert another PDF before/after the current page" />
                <ToggleButton x:Name="ReorderToggle" Content="Reorder" AutomationProperties.Name="Reorder pages"
                              Checked="ReorderToggle_Changed" Unchecked="ReorderToggle_Changed"
                              Padding="8,3" ToolTip="Drag thumbnails to reorder pages, then save" />
                <Button Content="Save order…" x:Name="SaveOrderButton" AutomationProperties.Name="Save page order" Click="SaveOrder_Click" Padding="8,3" ToolTip="Write the reordered pages to a new PDF" />
                <Separator Margin="6,0" Width="1" Background="{DynamicResource EdgeStrongBrush}" />
                <controls:HeadingTextBlock Text="Annotate" HeadingLevel="2" Foreground="{DynamicResource ContentMutedBrush}" VerticalAlignment="Center" Margin="0,0,6,0" AutomationProperties.Name="Annotate tools" />
                <Button Content="✱ highlight" AutomationProperties.Name="Add highlight" Click="AnnotateHighlight_Click" Padding="8,3" ToolTip="Add a highlight over the top of the current page" />
                <Button Content="🗨 note" AutomationProperties.Name="Add text note" Click="AnnotateText_Click" Padding="8,3" ToolTip="Add a text note to the current page" />
                <Button Content="✒ ink" AutomationProperties.Name="Add ink stroke" Click="AnnotateInk_Click" Padding="8,3" ToolTip="Add an ink stroke to the current page" />
                <Button Content="⚟ flatten…" AutomationProperties.Name="Flatten annotations" Click="AnnotateFlatten_Click" Padding="8,3" ToolTip="Save a copy with selected annotation types baked into static content" />
                <Separator Margin="6,0" Width="1" Background="{DynamicResource EdgeStrongBrush}" />
                <controls:HeadingTextBlock Text="Edit" HeadingLevel="2" Foreground="{DynamicResource ContentMutedBrush}" VerticalAlignment="Center" Margin="0,0,6,0" AutomationProperties.Name="Edit tools" />
                <ToggleButton x:Name="EditModeToggle" Content="✎ text" AutomationProperties.Name="Edit text mode"
                              Checked="EditModeToggle_Changed" Unchecked="EditModeToggle_Changed"
                              Padding="8,3" ToolTip="Click a word on the page to edit it; edits grow the box and warn on collision" />
                <ToggleButton x:Name="ObjectModeToggle" Content="⬒ object" AutomationProperties.Name="Object editing mode"
                              Checked="ObjectModeToggle_Changed" Unchecked="ObjectModeToggle_Changed"
                              Padding="8,3" ToolTip="Select, move, resize, or replace image/vector objects on the page" />
                <ToggleButton x:Name="FormModeToggle" Content="☑ form" AutomationProperties.Name="Form fill mode"
                              Checked="FormModeToggle_Changed" Unchecked="FormModeToggle_Changed"
                              Padding="8,3" ToolTip="Fill AcroForm fields on the page, then flatten the form to static content" />
                <ToggleButton x:Name="RedactModeToggle" Content="✖ redact" AutomationProperties.Name="Redact mode"
                              Checked="RedactModeToggle_Changed" Unchecked="RedactModeToggle_Changed"
                              Padding="8,3" ToolTip="Drag boxes over sensitive content; apply removes it and paints black (undoable)" />
                <Button Content="↩ Undo" AutomationProperties.Name="Undo" Click="EditUndo_Click" Padding="8,3" ToolTip="Undo last edit (Ctrl+Z)" />
                <Button Content="↪ Redo" AutomationProperties.Name="Redo" Click="EditRedo_Click" Padding="8,3" ToolTip="Redo last undone edit (Ctrl+Y)" />
                <Button Content="⇺ OCR…" AutomationProperties.Name="Run OCR" Click="Ocr_Click" Padding="8,3" ToolTip="Render a searchable copy: recognize the document's text offline and embed it (FR-OCR-01)" />
                <Button Content="🔒 Protect…" AutomationProperties.Name="Protect document" Click="Protect_Click" Padding="8,3" ToolTip="Write an encrypted copy protected by an open password (FR-SEC-01)" />
                <Separator Margin="6,0" Width="1" Background="{DynamicResource EdgeStrongBrush}" />
                <TextBox x:Name="SearchBox" AutomationProperties.Name="Search document text" Width="200" KeyDown="SearchBox_KeyDown" />
                <Button Content="Search" AutomationProperties.Name="Search" Click="Search_Click" Padding="10,3" />
            </StackPanel>
        </Border>

        <!-- Left sidebar -->
        <Grid DockPanel.Dock="Left" x:Name="Sidebar" Width="270" Margin="0,4,4,4" Background="{DynamicResource SurfacePanelBrush}">
            <TabControl Background="{DynamicResource SurfacePanelBrush}">
                <TabItem Header="Pages">
                    <ListBox x:Name="ThumbList" Background="{DynamicResource SurfacePanelBrush}" SelectionChanged="ThumbList_SelectionChanged"
                             AllowDrop="True" PreviewMouseLeftButtonDown="ThumbList_PreviewMouseLeftButtonDown"
                             PreviewMouseMove="ThumbList_PreviewMouseMove" Drop="ThumbList_Drop"
                             PreviewKeyDown="ThumbList_PreviewKeyDown"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Vertical" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource EdgeBrush}" BorderThickness="1" Margin="4"
                                        Background="{DynamicResource SurfacePanelBrush}" Cursor="Hand">
                                    <StackPanel>
                                        <Image Source="{Binding Thumbnail.Bitmap}"
                                               Width="160" Height="200" Stretch="Uniform"
                                               AutomationProperties.Name="{Binding AccessibleThumbnailName}"
                                               views:PageImageBehavior.RenderOnLoad="True" />
                                        <TextBlock Text="{Binding DisplayNumber, StringFormat=Page {0}}"
                                                   Foreground="{DynamicResource ContentMutedBrush}" FontSize="12" Margin="4,2" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </TabItem>
                <TabItem Header="Bookmarks">
                    <TreeView x:Name="OutlineTreeView" Background="{DynamicResource SurfacePanelBrush}"
                              BorderThickness="0"
                              SelectedItemChanged="OutlineTreeView_SelectedItemChanged">
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                    <TextBlock Text="{Binding Title}" Foreground="{DynamicResource ContentBrush}" FontSize="12"
                                               FontWeight="{Binding FontWeightPx}" />
                                    <TextBlock Text="{Binding PageLabel}" Foreground="{DynamicResource ContentMutedBrush}" Margin="8,0,0,0" />
                                </StackPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </TabItem>
                <TabItem Header="Search">
                    <ListBox x:Name="SearchList" Background="{DynamicResource SurfacePanelBrush}" SelectionChanged="SearchList_SelectionChanged"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="2,4">
                                    <TextBlock Foreground="{DynamicResource AccentTextBrush}" FontSize="12"
                                               Text="{Binding PageLabel}" />
                                    <TextBlock Text="{Binding Snippet}" Foreground="{DynamicResource ContentMutedBrush}" FontSize="12"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </TabItem>
                <TabItem Header="Annotations">
                    <DockPanel Background="{DynamicResource SurfacePanelBrush}">
                        <controls:HeadingTextBlock DockPanel.Dock="Top" Text="Annotations on current page" HeadingLevel="3" Foreground="{DynamicResource ContentMutedBrush}" FontSize="12" Margin="4,4,4,2" />
                        <ListBox x:Name="AnnotationList" Background="{DynamicResource SurfacePanelBrush}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="2,4">
                                        <TextBlock Foreground="{DynamicResource AccentTextBrush}" FontSize="12"
                                                   Text="{Binding TypeName}" />
                                        <TextBlock Foreground="{DynamicResource ContentMutedBrush}" FontSize="12"
                                                   Text="{Binding Description}" TextWrapping="Wrap" />
                                        <TextBlock Foreground="{DynamicResource ContentMutedBrush}" FontSize="12"
                                                   Text="{Binding Bounds}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </TabItem>
            </TabControl>
        </Grid>

        <!-- Center: page surface + status -->
        <DockPanel>
            <StatusBar DockPanel.Dock="Bottom" Background="{DynamicResource SurfaceRaisedBrush}">
                <ProgressBar Width="110" Height="12" IsIndeterminate="True" Margin="0,0,8,0"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"
                             AutomationProperties.Name="Working" />
                <TextBlock x:Name="StatusText" Foreground="{DynamicResource ContentMutedBrush}"
                           AutomationProperties.LiveSetting="Assertive" />
            </StatusBar>
            <Grid>
                <locals:ObjectEditView x:Name="ObjectView" Visibility="Collapsed" />
                <locals:FormFillView x:Name="FormView" Visibility="Collapsed" />
                <locals:RedactView x:Name="RedactViewHost" Visibility="Collapsed" />
                <ListBox x:Name="PageList" Background="{DynamicResource CanvasBrush}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling"
                     VirtualizingPanel.ScrollUnit="Pixel"
                     ScrollViewer.CanContentScroll="False"
                     PreviewKeyDown="PageList_PreviewKeyDown">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="HorizontalAlignment" Value="Center" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Focusable" Value="True" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="{DynamicResource PageBorderBrush}" BorderThickness="1" Margin="8,10"
                                Background="{DynamicResource PageSheetBrush}"
                                LayoutTransform="{Binding DataContext.Rotation, Converter={StaticResource RotationToTransform}, RelativeSource={RelativeSource AncestorType=ListBox}}">
                            <Grid>
                                <!-- Stretch=None is deliberate and fidelity-critical:
                                     the bitmap shows at exactly the DPI it was
                                     rendered at, so zoom means "re-render sharper",
                                     never "resample a cached bitmap up". -->
                                <Image Source="{Binding Image.Bitmap}" Stretch="None"
                                       CacheMode="BitmapCache"
                                       MouseLeftButtonUp="PageImage_MouseLeftButtonUp"
                                       AutomationProperties.Name="{Binding AccessibleImageName}"
                                       views:PageImageBehavior.RenderOnLoad="True" />
                                <!-- A render that fails must say so on the page
                                     rather than leaving a blank sheet. -->
                                <Border Background="{DynamicResource DangerSurfaceBrush}" Padding="12,8" MinWidth="240"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Visibility="{Binding Image.HasRenderError, Converter={StaticResource BoolToVis}}">
                                    <StackPanel>
                                        <controls:HeadingTextBlock HeadingLevel="3" Foreground="{DynamicResource DangerSurfaceForegroundBrush}"
                                                                   FontWeight="Bold" TextWrapping="Wrap"
                                                                   Text="{Binding DisplayNumber, StringFormat=Page {0} could not be rendered}" />
                                        <TextBlock Foreground="{DynamicResource DangerSurfaceMutedForegroundBrush}" FontSize="12" TextWrapping="Wrap"
                                                   Margin="0,4,0,0"
                                                   AutomationProperties.LiveSetting="Polite"
                                                   Text="{Binding Image.RenderError}" />
                                    </StackPanel>
                                </Border>
                                <Border x:Name="WordHighlight" BorderBrush="{DynamicResource SelectionBrush}"
                                        BorderThickness="2" Visibility="Collapsed"
                                        IsHitTestVisible="False"
                                        HorizontalAlignment="Left" VerticalAlignment="Top" />
                                <TextBlock Text="{Binding AccessibleText}"
                                           IsHitTestVisible="False" Opacity="0"
                                           TextWrapping="Wrap" VerticalAlignment="Stretch"
                                           AutomationProperties.Name="{Binding AccessibleImageName}"
                                           views:PageImageBehavior.EnsureTextOnLoad="True" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            </Grid>
        </DockPanel>
    </DockPanel>
</UserControl>
