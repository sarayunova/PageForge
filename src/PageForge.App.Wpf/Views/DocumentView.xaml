<UserControl x:Class="PageForge.App.Wpf.Views.DocumentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:PageForge.App.Wpf.ViewModels"
             xmlns:locals="clr-namespace:PageForge.App.Wpf.Views">
    <UserControl.Resources>
        <locals:RotationToTransformConverter x:Key="RotationToTransform" />
        <locals:ZoomPercentConverter x:Key="ZoomPercent" />
        <locals:IndentToWidthConverter x:Key="IndentToWidth" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <DockPanel>
        <!-- Top toolbar -->
        <Border DockPanel.Dock="Top" Background="#2b2b2b" Padding="6,4">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <ToggleButton x:Name="ContinuousToggle" Content="Continuous"
                              Checked="ContinuousToggle_Changed"
                              Unchecked="ContinuousToggle_Changed" Padding="10,3" />
                <Separator Margin="6,0" Width="1" Background="#555" />
                <Button Content="◀ Prev" Click="Previous_Click" Padding="8,3" />
                <TextBlock x:Name="PageIndicatorText" Foreground="#ddd" VerticalAlignment="Center"
                           Margin="10,0" MinWidth="70" TextAlignment="Center" />
                <Button Content="Next ▶" Click="Next_Click" Padding="8,3" />
                <Separator Margin="6,0" Width="1" Background="#555" />
                <Button Content="−" Click="ZoomOut_Click" Padding="10,3" ToolTip="Zoom out" />
                <TextBlock x:Name="ZoomText" Foreground="#ddd" VerticalAlignment="Center"
                           Margin="8,0" MinWidth="46" TextAlignment="Center" />
                <Button Content="+" Click="ZoomIn_Click" Padding="10,3" ToolTip="Zoom in" />
                <Button Content="Fit" Click="ZoomFit_Click" Padding="8,3" ToolTip="Fit width" />
                <Separator Margin="6,0" Width="1" Background="#555" />
                <Button Content="⟲" Click="RotateCCW_Click" Padding="10,3" ToolTip="Rotate counter-clockwise" />
                <Button Content="⟳" Click="RotateCW_Click" Padding="10,3" ToolTip="Rotate clockwise" />
                <Separator Margin="6,0" Width="1" Background="#555" />
                <TextBlock Text="Organize" Foreground="#aaa" VerticalAlignment="Center" Margin="0,0,6,0" />
                <Button Content="⟳ page" Click="OrganizeRotatePage_Click" Padding="8,3" ToolTip="Save a rotated copy of the current page to a new file" />
                <Button Content="✕ page" Click="OrganizeDeletePage_Click" Padding="8,3" ToolTip="Delete the current page into a new file" />
                <Button Content="✂ page" Click="OrganizeExtractPage_Click" Padding="8,3" ToolTip="Extract the current page to a new file" />
                <Button Content="⧉ insert…" Click="OrganizeInsert_Click" Padding="8,3" ToolTip="Insert another PDF before/after the current page" />
                <ToggleButton x:Name="ReorderToggle" Content="Reorder" Checked="ReorderToggle_Changed" Unchecked="ReorderToggle_Changed"
                              Padding="8,3" ToolTip="Drag thumbnails to reorder pages, then save" />
                <Button Content="Save order…" Click="SaveOrder_Click" Padding="8,3" ToolTip="Write the reordered pages to a new PDF" />
                <Separator Margin="6,0" Width="1" Background="#555" />
                <TextBlock Text="Annotate" Foreground="#aaa" VerticalAlignment="Center" Margin="0,0,6,0" />
                <Button Content="✱ highlight" Click="AnnotateHighlight_Click" Padding="8,3" ToolTip="Add a highlight over the top of the current page" />
                <Button Content="🗨 note" Click="AnnotateText_Click" Padding="8,3" ToolTip="Add a text note to the current page" />
                <Button Content="✒ ink" Click="AnnotateInk_Click" Padding="8,3" ToolTip="Add an ink stroke to the current page" />
                <Button Content="⚟ flatten…" Click="AnnotateFlatten_Click" Padding="8,3" ToolTip="Save a copy with selected annotation types baked into static content" />
                <Separator Margin="6,0" Width="1" Background="#555" />
                <TextBlock Text="Edit" Foreground="#aaa" VerticalAlignment="Center" Margin="0,0,6,0" />
                <ToggleButton x:Name="EditModeToggle" Content="✎ text" Checked="EditModeToggle_Changed" Unchecked="EditModeToggle_Changed"
                              Padding="8,3" ToolTip="Click a word on the page to edit it; edits grow the box and warn on collision" />
                <ToggleButton x:Name="ObjectModeToggle" Content="⬒ object" Checked="ObjectModeToggle_Changed" Unchecked="ObjectModeToggle_Changed"
                              Padding="8,3" ToolTip="Select, move, resize, or replace image/vector objects on the page" />
                <ToggleButton x:Name="FormModeToggle" Content="☑ form" Checked="FormModeToggle_Changed" Unchecked="FormModeToggle_Changed"
                              Padding="8,3" ToolTip="Fill AcroForm fields on the page, then flatten the form to static content" />
                <Button Content="↩ Undo" Click="EditUndo_Click" Padding="8,3" ToolTip="Undo last edit (Ctrl+Z)" />
                <Button Content="↪ Redo" Click="EditRedo_Click" Padding="8,3" ToolTip="Redo last undone edit (Ctrl+Y)" />
                <Separator Margin="6,0" Width="1" Background="#555" />
                <TextBox x:Name="SearchBox" Width="200" KeyDown="SearchBox_KeyDown" />
                <Button Content="Search" Click="Search_Click" Padding="10,3" />
            </StackPanel>
        </Border>

        <!-- Left sidebar -->
        <Grid DockPanel.Dock="Left" x:Name="Sidebar" Width="270" Margin="0,4,4,4">
            <TabControl>
                <TabItem Header="Pages">
                    <ListBox x:Name="ThumbList" SelectionChanged="ThumbList_SelectionChanged"
                             AllowDrop="True" PreviewMouseLeftButtonDown="ThumbList_PreviewMouseLeftButtonDown"
                             PreviewMouseMove="ThumbList_PreviewMouseMove" Drop="ThumbList_Drop"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Vertical" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#444" BorderThickness="1" Margin="4"
                                        Background="#1e1e1e" Cursor="Hand">
                                    <StackPanel>
                                        <Image Source="{Binding Thumbnail.Bitmap}"
                                               Width="160" Height="200" Stretch="Uniform"
                                               views:PageImageBehavior.RenderOnLoad="True" />
                                        <TextBlock Text="{Binding DisplayNumber, StringFormat=Page {0}}"
                                                   Foreground="#bbb" FontSize="11" Margin="4,2" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </TabItem>
                <TabItem Header="Bookmarks">
                    <ListBox x:Name="OutlineList" SelectionChanged="OutlineList_SelectionChanged"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                    <Border Width="{Binding Indent, Converter={StaticResource IndentToWidth}}" />
                                    <TextBlock Text="{Binding Title}" Foreground="#ddd" FontSize="12"
                                               FontWeight="{Binding FontWeightPx}" />
                                    <TextBlock Text="{Binding PageLabel}" Foreground="#888" Margin="8,0,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </TabItem>
                <TabItem Header="Search">
                    <ListBox x:Name="SearchList" SelectionChanged="SearchList_SelectionChanged"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="2,4">
                                    <TextBlock Foreground="#7fd" FontSize="11"
                                               Text="{Binding PageLabel}" />
                                    <TextBlock Text="{Binding Snippet}" Foreground="#ccc" FontSize="12"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </TabItem>
                <TabItem Header="Annotations">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Foreground="#888" FontSize="11" Margin="4,4,4,2"
                                   Text="Annotations on current page" />
                        <ListBox x:Name="AnnotationList"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="2,4">
                                        <TextBlock Foreground="#9df" FontSize="11"
                                                   Text="{Binding TypeName}" />
                                        <TextBlock Foreground="#ccc" FontSize="12"
                                                   Text="{Binding Description}" TextWrapping="Wrap" />
                                        <TextBlock Foreground="#666" FontSize="10"
                                                   Text="{Binding Bounds}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </TabItem>
            </TabControl>
        </Grid>

        <!-- Center: page surface + status -->
        <DockPanel>
            <StatusBar DockPanel.Dock="Bottom" Background="#2b2b2b">
                <TextBlock x:Name="StatusText" Foreground="#bbb" />
            </StatusBar>
            <Grid>
                <locals:ObjectEditView x:Name="ObjectView" Visibility="Collapsed" />
                <locals:FormFillView x:Name="FormView" Visibility="Collapsed" />
                <ListBox x:Name="PageList" Background="#3a3a3a"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling"
                     VirtualizingPanel.ScrollUnit="Pixel"
                     ScrollViewer.CanContentScroll="False">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="HorizontalAlignment" Value="Center" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Focusable" Value="False" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="#555" BorderThickness="1" Margin="8,10"
                                Background="White"
                                LayoutTransform="{Binding DataContext.Rotation, Converter={StaticResource RotationToTransform}, RelativeSource={RelativeSource AncestorType=ListBox}}">
                            <Image Source="{Binding Image.Bitmap}" Stretch="None"
                                   CacheMode="BitmapCache"
                                   MouseLeftButtonUp="PageImage_MouseLeftButtonUp"
                                   views:PageImageBehavior.RenderOnLoad="True" />
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            </Grid>
        </DockPanel>
    </DockPanel>
</UserControl>
