<UserControl x:Class="PageForge.App.Wpf.Views.DocumentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:PageForge.App.Wpf.Resources"
             xmlns:views="clr-namespace:PageForge.App.Wpf.ViewModels"
             xmlns:locals="clr-namespace:PageForge.App.Wpf.Views"
             xmlns:controls="clr-namespace:PageForge.App.Wpf.Controls"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <UserControl.Resources>
        <locals:RotationToTransformConverter x:Key="RotationToTransform" />
        <locals:ZoomPercentConverter x:Key="ZoomPercent" />
        <locals:IndentToWidthConverter x:Key="IndentToWidth" />
        <locals:PointsToPixelsConverter x:Key="PointsToPixels" />
        <locals:InverseBoolToVisibilityConverter x:Key="NotLoadedToVis" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <DockPanel>
        <!--
            Top chrome, in three rows.

            This used to be a single horizontal StackPanel holding roughly thirty
            controls: navigation, zoom, rotation, and every Organize / Annotate /
            Edit / Forms / Redact tool at once. It ran off the right edge of the
            window with no overflow handling, so the last commands were simply
            unreachable below about 1500px, and it offered no hierarchy - every
            mode shouted equally.

            Now: row 1 is the always-available command bar (bypass, page
            navigation, zoom, rotation, view mode, undo/redo, search); row 2 is a
            tool-group selector; row 3 shows only the selected group's commands.
            The mode TOGGLES inside each group are unchanged - same names, same
            handlers - so selecting a group only decides what is on screen, not
            what the editor is doing.

            The group selector uses RadioButtons sharing a GroupName so the mutual
            exclusion is real rather than hand-maintained, and so UIA and the
            keyboard get correct radio-group semantics for free.
        -->
        <StackPanel DockPanel.Dock="Top">

            <!-- Row 1: always-available commands. -->
            <Border Background="{DynamicResource SurfaceRaisedBrush}"
                    BorderBrush="{DynamicResource EdgeBrush}" BorderThickness="0,0,0,1"
                    Padding="8,5">
                <DockPanel LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                        <ToggleButton x:Name="SidebarToggle" IsChecked="True"
                                      AutomationProperties.Name="{loc:Str Document_ShowTheSidebar_Name}"
                                      Checked="SidebarToggle_Changed" Unchecked="SidebarToggle_Changed"
                                      Padding="8,3" Margin="0,0,8,0"
                                      ToolTip="{loc:Str Document_HideOrShowTheThumbnails_Tip}">
                            <ui:SymbolIcon Symbol="PanelLeft24" FontSize="14" />
                        </ToggleButton>
                        <Button x:Name="SkipToPageButton"
                                AutomationProperties.Name="{loc:Str Document_SkipToTheDocument_Name}"
                                Click="SkipToPage_Click" Padding="10,3"
                                ToolTip="{loc:Str Document_MoveKeyboardFocusToThe_Tip}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="ArrowExportUp24" FontSize="14" Margin="0,0,6,0" />
                                <TextBlock Text="{loc:Str Document_SkipToPage_Text}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Separator Margin="8,0" Width="1" Background="{DynamicResource EdgeStrongBrush}" />

                        <Button AutomationProperties.Name="{loc:Str Document_PreviousPage_Name}" Command="{Binding PreviousPageCommand}"
                                Padding="8,3" ToolTip="{loc:Str Document_PreviousPage_Tip}">
                            <ui:SymbolIcon Symbol="ArrowLeft24" FontSize="14" />
                        </Button>
                        <TextBlock x:Name="PageIndicatorText" Text="{Binding PageIndicator}" Foreground="{DynamicResource ContentBrush}"
                                   VerticalAlignment="Center" Margin="10,0" MinWidth="70" TextAlignment="Center" />
                        <Button x:Name="NextButton" AutomationProperties.Name="{loc:Str Document_NextPage_Name}" Command="{Binding NextPageCommand}"
                                Padding="8,3" ToolTip="{loc:Str Document_NextPage_Tip}">
                            <ui:SymbolIcon Symbol="ArrowRight24" FontSize="14" />
                        </Button>
                        <Separator Margin="8,0" Width="1" Background="{DynamicResource EdgeStrongBrush}" />

                        <Button AutomationProperties.Name="{loc:Str Document_ZoomOut_Name}" Command="{Binding ZoomOutCommand}"
                                Padding="8,3" ToolTip="{loc:Str Document_ZoomOut_Tip}">
                            <ui:SymbolIcon Symbol="ZoomOut24" FontSize="14" />
                        </Button>
                        <TextBlock x:Name="ZoomText" Text="{Binding Zoom, Converter={StaticResource ZoomPercent}}" Foreground="{DynamicResource ContentBrush}"
                                   VerticalAlignment="Center" Margin="8,0" MinWidth="46" TextAlignment="Center" />
                        <Button AutomationProperties.Name="{loc:Str Document_ZoomIn_Name}" Command="{Binding ZoomInCommand}"
                                Padding="8,3" ToolTip="{loc:Str Document_ZoomIn_Tip}">
                            <ui:SymbolIcon Symbol="ZoomIn24" FontSize="14" />
                        </Button>
                        <Button AutomationProperties.Name="{loc:Str Document_ResetZoomTo100_Name}" Command="{Binding ZoomResetCommand}"
                                Padding="8,3" ToolTip="{loc:Str Document_ResetZoomTo100_Tip}">
                            <ui:SymbolIcon Symbol="ArrowMaximize24" FontSize="14" />
                        </Button>
                        <Separator Margin="8,0" Width="1" Background="{DynamicResource EdgeStrongBrush}" />

                        <Button AutomationProperties.Name="{loc:Str Document_RotateCounterClockwise_Name}" Command="{Binding RotateCounterClockwiseCommand}"
                                Padding="8,3" ToolTip="{loc:Str Document_RotateTheViewCounterClockwise_Tip}">
                            <ui:SymbolIcon Symbol="ArrowRotateCounterclockwise24" FontSize="14" />
                        </Button>
                        <Button AutomationProperties.Name="{loc:Str Document_RotateClockwise_Name}" Command="{Binding RotateClockwiseCommand}"
                                Padding="8,3" ToolTip="{loc:Str Document_RotateTheViewClockwise_Tip}">
                            <ui:SymbolIcon Symbol="ArrowRotateClockwise24" FontSize="14" />
                        </Button>
                        <Separator Margin="8,0" Width="1" Background="{DynamicResource EdgeStrongBrush}" />

                        <ToggleButton x:Name="ContinuousToggle" Content="{loc:Str Document_Continuous}"
                                      AutomationProperties.Name="{loc:Str Document_ContinuousScrollMode_Name}"
                                      Checked="ContinuousToggle_Changed"
                                      Unchecked="ContinuousToggle_Changed" Padding="10,3"
                                      ToolTip="{loc:Str Document_ScrollAllPagesContinuouslyInstead_Tip}" />
                        <Separator Margin="8,0" Width="1" Background="{DynamicResource EdgeStrongBrush}" />

                        <!-- Undo/redo are document-wide, not tool-specific, so they
                             stay reachable whichever group is selected. -->
                        <Button AutomationProperties.Name="{loc:Str Document_Undo_Name}" Click="EditUndo_Click"
                                Padding="8,3" ToolTip="{loc:Str Document_UndoLastEditCtrlZ_Tip}">
                            <ui:SymbolIcon Symbol="ArrowUndo24" FontSize="14" />
                        </Button>
                        <Button AutomationProperties.Name="{loc:Str Document_Redo_Name}" Click="EditRedo_Click"
                                Padding="8,3" ToolTip="{loc:Str Document_RedoLastUndoneEditCtrl_Tip}">
                            <ui:SymbolIcon Symbol="ArrowRedo24" FontSize="14" />
                        </Button>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBox x:Name="SearchBox" AutomationProperties.Name="{loc:Str Document_SearchDocumentText_Name}"
                                 Width="200" KeyDown="SearchBox_KeyDown" VerticalAlignment="Center" />
                        <Button AutomationProperties.Name="{loc:Str Document_Search_Name}" Click="Search_Click"
                                Padding="8,3" Margin="6,0,0,0" ToolTip="{loc:Str Document_SearchTheDocumentText_Tip}">
                            <ui:SymbolIcon Symbol="Search24" FontSize="14" />
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Row 2: tool-group selector. -->
            <Border Background="{DynamicResource SurfacePanelBrush}"
                    BorderBrush="{DynamicResource EdgeBrush}" BorderThickness="0,0,0,1"
                    Padding="8,0">
                <StackPanel Orientation="Horizontal" AutomationProperties.Name="{loc:Str Document_ToolGroups_Name}">
                    <RadioButton x:Name="OrganizeModeTab" GroupName="ToolGroup" IsChecked="True"
                                 Style="{StaticResource ToolGroupTabStyle}"
                                 AutomationProperties.Name="{loc:Str Document_OrganizeToolGroup_Name}"
                                 Checked="ToolGroupTab_Checked" Content="{loc:Str Document_Organize}" />
                    <RadioButton x:Name="AnnotateModeTab" GroupName="ToolGroup"
                                 Style="{StaticResource ToolGroupTabStyle}"
                                 AutomationProperties.Name="{loc:Str Document_AnnotateToolGroup_Name}"
                                 Checked="ToolGroupTab_Checked" Content="{loc:Str Document_Annotate}" />
                    <RadioButton x:Name="EditModeTab" GroupName="ToolGroup"
                                 Style="{StaticResource ToolGroupTabStyle}"
                                 AutomationProperties.Name="{loc:Str Document_EditToolGroup_Name}"
                                 Checked="ToolGroupTab_Checked" Content="{loc:Str Document_Edit}" />
                    <RadioButton x:Name="FormsModeTab" GroupName="ToolGroup"
                                 Style="{StaticResource ToolGroupTabStyle}"
                                 AutomationProperties.Name="{loc:Str Document_FormToolGroup_Name}"
                                 Checked="ToolGroupTab_Checked" Content="{loc:Str Document_Forms}" />
                    <RadioButton x:Name="RedactModeTab" GroupName="ToolGroup"
                                 Style="{StaticResource ToolGroupTabStyle}"
                                 AutomationProperties.Name="{loc:Str Document_RedactToolGroup_Name}"
                                 Checked="ToolGroupTab_Checked" Content="{loc:Str Document_Redact}" />
                    <RadioButton x:Name="DocumentModeTab" GroupName="ToolGroup"
                                 Style="{StaticResource ToolGroupTabStyle}"
                                 AutomationProperties.Name="{loc:Str Document_DocumentToolGroup_Name}"
                                 Checked="ToolGroupTab_Checked" Content="{loc:Str Document_Document}" />
                </StackPanel>
            </Border>

            <!-- Row 3: the selected group's commands. Exactly one child is visible;
                 ToolGroupTab_Checked does the swapping. -->
            <Border Background="{DynamicResource SurfaceRaisedBrush}"
                    BorderBrush="{DynamicResource EdgeBrush}" BorderThickness="0,0,0,1"
                    Padding="8,5" MinHeight="38">
                <Grid>
                    <StackPanel x:Name="OrganizeGroup" Orientation="Horizontal" VerticalAlignment="Center">
                        <controls:HeadingTextBlock Text="{loc:Str Document_Organize_Text}" HeadingLevel="2"
                                                   Foreground="{DynamicResource ContentMutedBrush}"
                                                   VerticalAlignment="Center" Margin="0,0,10,0"
                                                   AutomationProperties.Name="{loc:Str Document_OrganizeTools_Name}" />
                        <Button AutomationProperties.Name="{loc:Str Document_RotatePage_Name}" Click="OrganizeRotatePage_Click"
                                Padding="10,3" Margin="0,0,4,0"
                                ToolTip="{loc:Str Document_SaveARotatedCopyOf_Tip}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="ArrowRotateClockwise24" FontSize="14" Margin="0,0,6,0" />
                                <TextBlock Text="{loc:Str Document_RotatePage_Text}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button AutomationProperties.Name="{loc:Str Document_DeletePage_Name}" Click="OrganizeDeletePage_Click"
                                Padding="10,3" Margin="0,0,4,0"
                                ToolTip="{loc:Str Document_DeleteTheCurrentPageInto_Tip}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Delete24" FontSize="14" Margin="0,0,6,0" />
                                <TextBlock Text="{loc:Str Document_DeletePage_Text}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button AutomationProperties.Name="{loc:Str Document_ExtractPage_Name}" Click="OrganizeExtractPage_Click"
                                Padding="10,3" Margin="0,0,4,0"
                                ToolTip="{loc:Str Document_ExtractTheCurrentPageTo_Tip}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Cut24" FontSize="14" Margin="0,0,6,0" />
                                <TextBlock Text="{loc:Str Document_ExtractPage_Text}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button AutomationProperties.Name="{loc:Str Document_InsertPage_Name}" Click="OrganizeInsert_Click"
                                Padding="10,3" Margin="0,0,4,0"
                                ToolTip="{loc:Str Document_InsertAnotherPdfBeforeAfter_Tip}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="DocumentAdd24" FontSize="14" Margin="0,0,6,0" />
                                <TextBlock Text="{loc:Str Document_Insert_Text}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Separator Margin="8,0" Width="1" Background="{DynamicResource EdgeStrongBrush}" />
                        <ToggleButton x:Name="ReorderToggle" AutomationProperties.Name="{loc:Str Document_ReorderPages_Name}"
                                      Checked="ReorderToggle_Changed" Unchecked="ReorderToggle_Changed"
                                      Padding="10,3" Margin="0,0,4,0"
                                      ToolTip="{loc:Str Document_DragThumbnailsToReorderPages_Tip}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="ReOrder24" FontSize="14" Margin="0,0,6,0" />
                                <TextBlock Text="{loc:Str Document_Reorder_Text}" VerticalAlignment="Center" />
                            </StackPanel>
                        </ToggleButton>
                        <Button x:Name="SaveOrderButton" AutomationProperties.Name="{loc:Str Document_SavePageOrder_Name}"
                                Click="SaveOrder_Click" Padding="10,3"
                                ToolTip="{loc:Str Document_WriteTheReorderedPagesTo_Tip}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Save24" FontSize="14" Margin="0,0,6,0" />
                                <TextBlock Text="{loc:Str Document_SaveOrder_Text}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <StackPanel x:Name="AnnotateGroup" Orientation="Horizontal" VerticalAlignment="Center"
                                Visibility="Collapsed">
                        <controls:HeadingTextBlock Text="{loc:Str Document_Annotate_Text}" HeadingLevel="2"
                                                   Foreground="{DynamicResource ContentMutedBrush}"
                                                   VerticalAlignment="Center" Margin="0,0,10,0"
                                                   AutomationProperties.Name="{loc:Str Document_AnnotateTools_Name}" />
                        <Button AutomationProperties.Name="{loc:Str Document_AddHighlight_Name}" Click="AnnotateHighlight_Click"
                                Padding="10,3" Margin="0,0,4,0"
                                ToolTip="{loc:Str Document_AddAHighlightOverThe_Tip}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Highlight24" FontSize="14" Margin="0,0,6,0"
                                               Foreground="{DynamicResource AnnotationHighlightBrush}" />
                                <TextBlock Text="{loc:Str Document_Highlight_Text}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button AutomationProperties.Name="{loc:Str Document_AddTextNote_Name}" Click="AnnotateText_Click"
                                Padding="10,3" Margin="0,0,4,0"
                                ToolTip="{loc:Str Document_AddATextNoteTo_Tip}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Comment24" FontSize="14" Margin="0,0,6,0"
                                               Foreground="{DynamicResource AnnotationNoteBrush}" />
                                <TextBlock Text="{loc:Str Document_Note_Text}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button AutomationProperties.Name="{loc:Str Document_AddInkStroke_Name}" Click="AnnotateInk_Click"
                                Padding="10,3" Margin="0,0,4,0"
                                ToolTip="{loc:Str Document_AddAnInkStrokeTo_Tip}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="InkingTool24" FontSize="14" Margin="0,0,6,0"
                                               Foreground="{DynamicResource AnnotationInkBrush}" />
                                <TextBlock Text="{loc:Str Document_Ink_Text}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Separator Margin="8,0" Width="1" Background="{DynamicResource EdgeStrongBrush}" />
                        <Button AutomationProperties.Name="{loc:Str Document_FlattenAnnotations_Name}" Click="AnnotateFlatten_Click"
                                Padding="10,3"
                                ToolTip="{loc:Str Document_SaveACopyWithSelected_Tip}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Layer24" FontSize="14" Margin="0,0,6,0" />
                                <TextBlock Text="{loc:Str Document_Flatten_Text}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <StackPanel x:Name="EditGroup" Orientation="Horizontal" VerticalAlignment="Center"
                                Visibility="Collapsed">
                        <controls:HeadingTextBlock Text="{loc:Str Document_Edit_Text}" HeadingLevel="2"
                                                   Foreground="{DynamicResource ContentMutedBrush}"
                                                   VerticalAlignment="Center" Margin="0,0,10,0"
                                                   AutomationProperties.Name="{loc:Str Document_EditTools_Name}" />
                        <ToggleButton x:Name="EditModeToggle" AutomationProperties.Name="{loc:Str Document_EditTextMode_Name}"
                                      Checked="EditModeToggle_Changed" Unchecked="EditModeToggle_Changed"
                                      Padding="10,3" Margin="0,0,4,0"
                                      ToolTip="{loc:Str Document_ClickAWordOnThe_Tip}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="TextT24" FontSize="14" Margin="0,0,6,0" />
                                <TextBlock Text="{loc:Str Document_EditText_Text}" VerticalAlignment="Center" />
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton x:Name="ObjectModeToggle" AutomationProperties.Name="{loc:Str Document_ObjectEditingMode_Name}"
                                      Checked="ObjectModeToggle_Changed" Unchecked="ObjectModeToggle_Changed"
                                      Padding="10,3"
                                      ToolTip="{loc:Str Document_SelectMoveResizeOrReplace_Tip}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Shapes24" FontSize="14" Margin="0,0,6,0" />
                                <TextBlock Text="{loc:Str Document_EditObjects_Text}" VerticalAlignment="Center" />
                            </StackPanel>
                        </ToggleButton>
                    </StackPanel>

                    <StackPanel x:Name="FormsGroup" Orientation="Horizontal" VerticalAlignment="Center"
                                Visibility="Collapsed">
                        <controls:HeadingTextBlock Text="{loc:Str Document_Forms_Text}" HeadingLevel="2"
                                                   Foreground="{DynamicResource ContentMutedBrush}"
                                                   VerticalAlignment="Center" Margin="0,0,10,0"
                                                   AutomationProperties.Name="{loc:Str Document_FormTools_Name}" />
                        <ToggleButton x:Name="FormModeToggle" AutomationProperties.Name="{loc:Str Document_FormFillMode_Name}"
                                      Checked="FormModeToggle_Changed" Unchecked="FormModeToggle_Changed"
                                      Padding="10,3"
                                      ToolTip="{loc:Str Document_FillAcroformFieldsOnThe_Tip}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Checkbox124" FontSize="14" Margin="0,0,6,0" />
                                <TextBlock Text="{loc:Str Document_FillForm_Text}" VerticalAlignment="Center" />
                            </StackPanel>
                        </ToggleButton>
                    </StackPanel>

                    <StackPanel x:Name="RedactGroup" Orientation="Horizontal" VerticalAlignment="Center"
                                Visibility="Collapsed">
                        <controls:HeadingTextBlock Text="{loc:Str Document_Redact_Text}" HeadingLevel="2"
                                                   Foreground="{DynamicResource ContentMutedBrush}"
                                                   VerticalAlignment="Center" Margin="0,0,10,0"
                                                   AutomationProperties.Name="{loc:Str Document_RedactTools_Name}" />
                        <ToggleButton x:Name="RedactModeToggle" AutomationProperties.Name="{loc:Str Document_RedactMode_Name}"
                                      Checked="RedactModeToggle_Changed" Unchecked="RedactModeToggle_Changed"
                                      Padding="10,3"
                                      ToolTip="{loc:Str Document_DragBoxesOverSensitiveContent_Tip}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Eraser24" FontSize="14" Margin="0,0,6,0"
                                               Foreground="{DynamicResource DangerBrush}" />
                                <TextBlock Text="{loc:Str Document_Redact_Text}" VerticalAlignment="Center" />
                            </StackPanel>
                        </ToggleButton>
                    </StackPanel>

                    <StackPanel x:Name="DocumentGroup" Orientation="Horizontal" VerticalAlignment="Center"
                                Visibility="Collapsed">
                        <controls:HeadingTextBlock Text="{loc:Str Document_Document_Text}" HeadingLevel="2"
                                                   Foreground="{DynamicResource ContentMutedBrush}"
                                                   VerticalAlignment="Center" Margin="0,0,10,0"
                                                   AutomationProperties.Name="{loc:Str Document_DocumentTools_Name}" />
                        <Button AutomationProperties.Name="{loc:Str Document_RunOcr_Name}" Click="Ocr_Click"
                                Padding="10,3" Margin="0,0,4,0"
                                ToolTip="{loc:Str Document_RenderASearchableCopyRecognize_Tip}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="ScanText24" FontSize="14" Margin="0,0,6,0" />
                                <TextBlock Text="{loc:Str Document_Ocr_Text}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button AutomationProperties.Name="{loc:Str Document_ProtectDocument_Name}" Click="Protect_Click"
                                Padding="10,3"
                                ToolTip="{loc:Str Document_WriteAnEncryptedCopyProtected_Tip}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="LockClosed24" FontSize="14" Margin="0,0,6,0" />
                                <TextBlock Text="{loc:Str Document_Protect_Text}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button AutomationProperties.Name="{loc:Str Document_SignDocument_Name}" Click="Sign_Click"
                                Padding="10,3"
                                ToolTip="{loc:Str Document_SignACopyWithA_Tip}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Signature24" FontSize="14" Margin="0,0,6,0" />
                                <TextBlock Text="{loc:Str Document_Sign_Text}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button AutomationProperties.Name="{loc:Str Document_CheckSignatures_Name}" Click="Signatures_Click"
                                Padding="10,3"
                                ToolTip="{loc:Str Document_CheckTheSignaturesThisDocument_Tip}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="14" Margin="0,0,6,0" />
                                <TextBlock Text="{loc:Str Document_Signatures_Text}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>

        <!--
            Sidebar, splitter and page surface share a Grid rather than being
            docked. A fixed 270px sidebar was a Phase U3 gap: a DockPanel offers
            no way to drag the boundary, and the width that suits a thumbnail
            strip is not the width that suits a long outline. The column carries
            the width now, so the splitter and the collapse toggle have exactly
            one thing to change between them.
        -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="270" MinWidth="180" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="320" />
            </Grid.ColumnDefinitions>

        <!-- Left sidebar -->
        <Grid Grid.Column="0" x:Name="Sidebar" Margin="0,4,4,4" Background="{DynamicResource SurfacePanelBrush}">
            <TabControl Background="{DynamicResource SurfacePanelBrush}">
                <TabItem Header="{loc:Str Document_Pages_Header}">
                    <ListBox x:Name="ThumbList" ItemsSource="{Binding ThumbnailItems}" Background="{DynamicResource SurfacePanelBrush}" SelectionChanged="ThumbList_SelectionChanged"
                             AllowDrop="True" PreviewMouseLeftButtonDown="ThumbList_PreviewMouseLeftButtonDown"
                             PreviewMouseMove="ThumbList_PreviewMouseMove" Drop="ThumbList_Drop"
                             PreviewKeyDown="ThumbList_PreviewKeyDown"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Vertical" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <!-- Name the list ITEM, not only the image inside it. An
                             unnamed item falls back to ToString() on the view model,
                             so every page in the thumbnail strip announced itself as
                             "PageForge.App.Wpf.ViewModels.PageSlotViewModel" - in the
                             most-used list in the application. The redaction and
                             object-edit lists were given this treatment; the page
                             list, which predates them, was missed. -->
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleThumbnailName}" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource EdgeBrush}" BorderThickness="1" Margin="4"
                                        Background="{DynamicResource SurfacePanelBrush}" Cursor="Hand">
                                    <StackPanel>
                                        <Image Source="{Binding Thumbnail.Bitmap}"
                                               Width="160" Height="200" Stretch="Uniform"
                                               AutomationProperties.Name="{Binding AccessibleThumbnailName}"
                                               views:PageImageBehavior.RenderOnLoad="True" />
                                        <TextBlock Text="{Binding DisplayNumber, StringFormat=Page {0}}"
                                                   Foreground="{DynamicResource ContentMutedBrush}" FontSize="12" Margin="4,2" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </TabItem>
                <TabItem Header="{loc:Str Document_Bookmarks_Header}">
                    <TreeView x:Name="OutlineTreeView" ItemsSource="{Binding OutlineTree}" Background="{DynamicResource SurfacePanelBrush}"
                              BorderThickness="0"
                              SelectedItemChanged="OutlineTreeView_SelectedItemChanged">
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                    <TextBlock Text="{Binding Title}" Foreground="{DynamicResource ContentBrush}" FontSize="12"
                                               FontWeight="{Binding FontWeightPx}" />
                                    <TextBlock Text="{Binding PageLabel}" Foreground="{DynamicResource ContentMutedBrush}" Margin="8,0,0,0" />
                                </StackPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </TabItem>
                <TabItem Header="{loc:Str Document_Search_Header}">
                    <ListBox x:Name="SearchList" ItemsSource="{Binding SearchHits}" Background="{DynamicResource SurfacePanelBrush}" SelectionChanged="SearchList_SelectionChanged"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="2,4">
                                    <TextBlock Foreground="{DynamicResource AccentTextBrush}" FontSize="12"
                                               Text="{Binding PageLabel}" />
                                    <TextBlock Text="{Binding Snippet}" Foreground="{DynamicResource ContentMutedBrush}" FontSize="12"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </TabItem>
                <TabItem Header="{loc:Str Document_Annotations_Header}">
                    <DockPanel Background="{DynamicResource SurfacePanelBrush}">
                        <controls:HeadingTextBlock DockPanel.Dock="Top" Text="{loc:Str Document_AnnotationsOnCurrentPage_Text}" HeadingLevel="3" Foreground="{DynamicResource ContentMutedBrush}" FontSize="12" Margin="4,4,4,2" />
                        <ListBox x:Name="AnnotationList" ItemsSource="{Binding Annotations}" Background="{DynamicResource SurfacePanelBrush}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="2,4">
                                        <TextBlock Foreground="{DynamicResource AccentTextBrush}" FontSize="12"
                                                   Text="{Binding TypeName}" />
                                        <TextBlock Foreground="{DynamicResource ContentMutedBrush}" FontSize="12"
                                                   Text="{Binding Description}" TextWrapping="Wrap" />
                                        <TextBlock Foreground="{DynamicResource ContentMutedBrush}" FontSize="12"
                                                   Text="{Binding Bounds}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </TabItem>
            </TabControl>
        </Grid>

        <!-- Drag handle. Focusable with a keyboard name, because a mouse-only
             way to resize a panel is not a way at all (WCAG 2.1.1). -->
        <GridSplitter x:Name="SidebarSplitter" Grid.Column="1" Width="5" HorizontalAlignment="Stretch"
                      Background="{DynamicResource EdgeBrush}"
                      Focusable="True"
                      AutomationProperties.Name="{loc:Str Document_ResizeTheSidebar_Name}"
                      ToolTip="{loc:Str Document_DragToResizeTheSidebar_Tip}" />

        <!-- Center: page surface + status -->
        <DockPanel Grid.Column="2">
            <StatusBar DockPanel.Dock="Bottom" Background="{DynamicResource SurfaceRaisedBrush}">
                <ProgressBar Width="110" Height="12" IsIndeterminate="True" Margin="0,0,8,0"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"
                             AutomationProperties.Name="{loc:Str Document_Working_Name}" />
                <TextBlock x:Name="StatusText" Text="{Binding Status}" Foreground="{DynamicResource ContentMutedBrush}"
                           AutomationProperties.LiveSetting="Assertive" />
            </StatusBar>
            <Grid>
                <locals:ObjectEditView x:Name="ObjectView" Visibility="Collapsed" />
                <locals:FormFillView x:Name="FormView" Visibility="Collapsed" />
                <locals:RedactView x:Name="RedactViewHost" Visibility="Collapsed" />
                <locals:SignPlaceView x:Name="SignPlaceHost" Visibility="Collapsed" />
                <ListBox x:Name="PageList" ItemsSource="{Binding VisiblePages}" Background="{DynamicResource CanvasBrush}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling"
                     VirtualizingPanel.ScrollUnit="Pixel"
                     ScrollViewer.CanContentScroll="False"
                     PreviewKeyDown="PageList_PreviewKeyDown">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="HorizontalAlignment" Value="Center" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Focusable" Value="True" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <!-- A sheet, not a rectangle. The page used to sit on the
                             canvas as a 1px outline, which reads as a box drawn on a
                             background rather than as paper lying on a desk - the
                             cue every other PDF reader gives you for where the page
                             ends. The shadow is soft and nearly black at low opacity
                             so it works over both the light and dark canvas without
                             needing a token of its own.

                             Margin is wider than the old 8,10 so consecutive pages
                             in continuous mode do not run their shadows together. -->
                        <Border BorderBrush="{DynamicResource PageBorderBrush}" BorderThickness="1" Margin="16,14"
                                Background="{DynamicResource PageSheetBrush}"
                                LayoutTransform="{Binding DataContext.Rotation, Converter={StaticResource RotationToTransform}, RelativeSource={RelativeSource AncestorType=ListBox}}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="14" ShadowDepth="3" Direction="270"
                                                  Color="#FF000000" Opacity="0.28" RenderingBias="Performance" />
                            </Border.Effect>
                            <Grid>
                                <!-- Placeholder, shown until this page's bitmap
                                     exists. Without it a page that has not rendered
                                     yet is a zero-height sliver, so the scrollbar
                                     grows as pages arrive and the surface jumps
                                     under the reader. Sized from the page's own
                                     points at the current DPI, because the image it
                                     stands in for is exactly what does not exist
                                     yet. -->
                                <Border Visibility="{Binding Image.IsLoaded, Converter={StaticResource NotLoadedToVis}}"
                                        Background="{DynamicResource SurfaceHoverBrush}">
                                    <Border.Width>
                                        <MultiBinding Converter="{StaticResource PointsToPixels}">
                                            <Binding Path="Region.WidthPt" />
                                            <Binding Path="Image.RenderDpi" />
                                        </MultiBinding>
                                    </Border.Width>
                                    <Border.Height>
                                        <MultiBinding Converter="{StaticResource PointsToPixels}">
                                            <Binding Path="Region.HeightPt" />
                                            <Binding Path="Image.RenderDpi" />
                                        </MultiBinding>
                                    </Border.Height>
                                    <!-- Near the top, not centred. A page is usually
                                         taller than the viewport, so a centred
                                         message sits below the fold and the reader
                                         sees an unexplained grey sheet - which is
                                         exactly what the first version did. -->
                                    <TextBlock Text="{Binding DisplayNumber, StringFormat=Rendering page {0}…}"
                                               Foreground="{DynamicResource ContentMutedBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Top"
                                               Margin="0,32,0,0"
                                               AutomationProperties.LiveSetting="Polite" />
                                </Border>

                                <!-- Stretch=None is deliberate and fidelity-critical:
                                     the bitmap shows at exactly the DPI it was
                                     rendered at, so zoom means "re-render sharper",
                                     never "resample a cached bitmap up". -->
                                <Image Source="{Binding Image.Bitmap}" Stretch="None"
                                       CacheMode="BitmapCache"
                                       MouseLeftButtonUp="PageImage_MouseLeftButtonUp"
                                       AutomationProperties.Name="{Binding AccessibleImageName}"
                                       views:PageImageBehavior.RenderOnLoad="True" />
                                <!-- A render that fails must say so on the page
                                     rather than leaving a blank sheet. -->
                                <Border Background="{DynamicResource DangerSurfaceBrush}" Padding="12,8" MinWidth="240"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Visibility="{Binding Image.HasRenderError, Converter={StaticResource BoolToVis}}">
                                    <StackPanel>
                                        <controls:HeadingTextBlock HeadingLevel="3" Foreground="{DynamicResource DangerSurfaceForegroundBrush}"
                                                                   FontWeight="Bold" TextWrapping="Wrap"
                                                                   Text="{Binding DisplayNumber, StringFormat=Page {0} could not be rendered}" />
                                        <TextBlock Foreground="{DynamicResource DangerSurfaceMutedForegroundBrush}" FontSize="12" TextWrapping="Wrap"
                                                   Margin="0,4,0,0"
                                                   AutomationProperties.LiveSetting="Polite"
                                                   Text="{Binding Image.RenderError}" />
                                        <!-- A render can fail for reasons that pass
                                             on a second attempt (a transient file
                                             lock, memory pressure at a high zoom),
                                             so reporting without offering a retry
                                             would strand the page. -->
                                        <Button Content="{loc:Str Document_TryAgain}" Margin="0,8,0,0" Padding="12,4"
                                                HorizontalAlignment="Left"
                                                AutomationProperties.Name="{loc:Str Document_TryRenderingThisPageAgain_Name}"
                                                Click="PageRetryRender_Click" />
                                    </StackPanel>
                                </Border>
                                <Border x:Name="WordHighlight" BorderBrush="{DynamicResource SelectionBrush}"
                                        BorderThickness="2" Visibility="Collapsed"
                                        IsHitTestVisible="False"
                                        HorizontalAlignment="Left" VerticalAlignment="Top" />
                                <TextBlock Text="{Binding AccessibleText}"
                                           IsHitTestVisible="False" Opacity="0"
                                           TextWrapping="Wrap" VerticalAlignment="Stretch"
                                           AutomationProperties.Name="{Binding AccessibleImageName}"
                                           views:PageImageBehavior.EnsureTextOnLoad="True" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            </Grid>
        </DockPanel>
        </Grid>
    </DockPanel>
</UserControl>
