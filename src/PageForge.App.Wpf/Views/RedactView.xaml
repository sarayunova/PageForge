<UserControl x:Class="PageForge.App.Wpf.Views.RedactView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:locals="clr-namespace:PageForge.App.Wpf.Views">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <locals:ZeroCountToVisibilityConverter x:Key="ZeroToVis" />
    </UserControl.Resources>

    <DockPanel Background="{DynamicResource CanvasBrush}">
        <!-- Redact toolbar -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource SurfaceRaisedBrush}" Padding="6,4">
            <!-- The commands dock right and the hint takes what is left, so the
                 hint can never push a button off the edge of the window. As a
                 StackPanel this row ran past 1200px and Save redacted… was
                 unreachable - the same overflow Phase U2 fixed on the main
                 toolbar, which the contextual rows did not get. -->
            <DockPanel LastChildFill="True">
                <TextBlock Text="Redact" DockPanel.Dock="Left" Foreground="{DynamicResource DangerBrush}" FontWeight="Bold"
                           VerticalAlignment="Center" Margin="0,0,10,0" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="↩ Undo" AutomationProperties.Name="Undo redaction" Click="Undo_Click" Padding="8,3"
                            ToolTip="Undo the last redaction apply (restores the covered content from a snapshot)" />
                    <Separator Margin="6,0" Width="1" Background="{DynamicResource EdgeStrongBrush}" />
                    <Button Content="Save redacted…" Click="SaveRedacted_Click" Padding="8,3"
                            ToolTip="Write a new PDF with the redactions applied and the covered content permanently gone" />
                </StackPanel>
                <TextBlock x:Name="HintText" Text="Drag a box over content to remove, or use the keyboard: Enter begins a box, arrows size it, Ctrl+arrows move it, Enter places it, Esc cancels. Apply deletes the covered text and paints it black (undoable)."
                           Foreground="{DynamicResource ContentMutedBrush}" VerticalAlignment="Center" Margin="0,0,10,0"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                           AutomationProperties.LiveSetting="Polite" />
            </DockPanel>
        </Border>

        <!-- A DockPanel, not a Grid: DockPanel.Dock is an attached property that
             only means anything when the direct parent is a DockPanel. With a Grid
             here it was silently ignored, so the regions panel and the page were
             both laid out in the same single cell and the page - declared second,
             so drawn on top - hid the panel completely. -->
        <DockPanel LastChildFill="True">
            <!-- Right: marked regions + apply -->
            <DockPanel DockPanel.Dock="Right" Width="300" Margin="4">
                <Border DockPanel.Dock="Top" Background="{DynamicResource SurfaceRaisedBrush}" Padding="6,4">
                    <TextBlock Text="Regions marked on this page" Foreground="{DynamicResource ContentBrush}" FontWeight="Bold" />
                </Border>
                <!-- The Apply bar is declared before the scrolling list on purpose.
                     A DockPanel gives the fill slot to its LAST child whatever that
                     child's Dock says, so with the list first the Apply bar took the
                     whole remaining area and the button vanished off the panel. The
                     list is the thing that should absorb the leftover space, so it
                     goes last. -->
                <Border DockPanel.Dock="Bottom" Background="{DynamicResource SurfaceRaisedBrush}" Padding="6,4">
                    <Button x:Name="ApplyButton" Content="Apply redactions…" IsEnabled="False"
                            Click="Apply_Click" Padding="10,4" HorizontalAlignment="Right"
                            ToolTip="Delete every marked region's content now (undoable via ↩ Undo)" />
                </Border>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{DynamicResource SurfaceAppBrush}">
                    <Grid>
                        <!-- The same collection the overlay draws, listed. Two
                             templates over one source, so the boxes on the page and
                             the rows beside it cannot disagree about what is marked. -->
                        <ItemsControl x:Name="RegionsPanel"
                                      ItemsSource="{Binding Regions, RelativeSource={RelativeSource AncestorType=UserControl}}">
                            <!-- Name the list ITEM, not only the text inside it. An
                                 unnamed item falls back to ToString() on the view
                                 model, so a screen reader reads out the class name. -->
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Label}" Margin="8,6"
                                               Foreground="{DynamicResource ContentBrush}"
                                               AutomationProperties.Name="{Binding AccessibleName}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Shown only when nothing is marked. Bound to the count so
                             it cannot be left behind by a path that forgets to clear
                             it, which is what a hand-built list invites. -->
                        <TextBlock x:Name="NoRegionsText" Margin="8" TextWrapping="Wrap"
                                   Foreground="{DynamicResource ContentMutedBrush}"
                                   Text="No regions on this page yet — drag a box over the content to redact."
                                   Visibility="{Binding Regions.Count, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource ZeroToVis}}" />
                    </Grid>
                </ScrollViewer>
            </DockPanel>

            <!-- Left: page + overlay -->
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                          Background="{DynamicResource CanvasBrush}">
                <Grid x:Name="PageHost" Background="White" Margin="24">
                    <Image x:Name="PageImage" Stretch="None" SnapsToDevicePixels="True"
                       AutomationProperties.Name="Redact page" />

                    <!-- Committed regions, bound. Their own layer beneath Overlay,
                         which keeps its Canvas because the rubber band drawn during
                         a drag is genuinely transient view state and has no business
                         in a collection. Not hit-testable: Overlay owns the mouse. -->
                    <ItemsControl ItemsSource="{Binding Regions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  IsHitTestVisible="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas ClipToBounds="True" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Canvas.Left" Value="{Binding Left}" />
                                <Setter Property="Canvas.Top" Value="{Binding Top}" />
                                <!-- Without this the item announces ToString() on the view model, i.e. the class name. -->
                                <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Rectangle Width="{Binding Width}" Height="{Binding Height}"
                                           Fill="#28D01010" Stroke="#CCD01010" StrokeThickness="1"
                                           AutomationProperties.Name="{Binding AccessibleName}">
                                    <Rectangle.StrokeDashArray>
                                        <DoubleCollection>4 2</DoubleCollection>
                                    </Rectangle.StrokeDashArray>
                                </Rectangle>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Background is load-bearing, not styling. A Panel whose
                         Background is null is invisible to hit testing, so this
                         overlay never received the mouse and drag-to-mark did
                         nothing at all: the presses went to the page Image
                         underneath, which is not an ancestor of this Canvas, so
                         they never reached these handlers. It looked right in
                         every screenshot, and nothing drove a mouse at it until
                         the signature placement surface hit the same wall. -->
                    <Canvas x:Name="Overlay" Background="Transparent" ClipToBounds="True" Focusable="True"
                            MouseLeftButtonDown="Overlay_MouseLeftButtonDown"
                            MouseMove="Overlay_MouseMove"
                            MouseLeftButtonUp="Overlay_MouseLeftButtonUp"
                            Cursor="Cross" />
                </Grid>
            </ScrollViewer>
        </DockPanel>
    </DockPanel>
</UserControl>