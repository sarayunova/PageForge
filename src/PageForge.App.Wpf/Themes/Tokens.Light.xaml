<!--
    PageForge light theme tokens.

    FrameForge is dark-only, so unlike Tokens.Dark.xaml this is not a port but a
    derivation: the surface ramp is inverted to the same five steps with the same
    relative separation, and the accent is held at the family value so the two
    products still read as siblings. PageForge needs a light theme FrameForge
    does not, because it is a document tool - people read long PDFs in bright
    rooms, and the page itself is white.

    This file MUST define exactly the key set in Tokens.Dark.xaml: ThemeManager
    swaps one dictionary for the other and consumers use DynamicResource, so a
    missing key is a runtime blank rather than a build error.

    Contrast (WCAG 2.1 AA, measured against SurfacePanelBrush #ffffff):
      ContentBrush       #12151a  17.4:1  PASS body text
      ContentMutedBrush  #4a5462   7.67:1 PASS body text
      ContentFaintBrush  #6b7684   4.61:1 PASS body text (slim margin)
      AccentTextBrush    #1f5fd0   5.82:1 PASS body text

    Note the accent split. The family accent #4c8dff measures only 3.20:1 on
    white, which fails AA for text. It is therefore kept for FILLS (AccentBrush,
    where the pairing is white-on-accent) while accent-coloured TEXT uses the
    darkened AccentTextBrush. Do not collapse the two tokens back together.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <sys:String x:Key="ThemeName">Light</sys:String>

    <!-- Surface ramp, inverted: app background -> panel -> raised/header -> hover -> active. -->
    <Color x:Key="SurfaceAppColor">#FFF4F6F8</Color>
    <Color x:Key="SurfacePanelColor">#FFFFFFFF</Color>
    <Color x:Key="SurfaceRaisedColor">#FFEEF1F5</Color>
    <Color x:Key="SurfaceHoverColor">#FFE3E8EE</Color>
    <Color x:Key="SurfaceActiveColor">#FFD5DCE5</Color>

    <SolidColorBrush x:Key="SurfaceAppBrush" Color="{StaticResource SurfaceAppColor}" />
    <SolidColorBrush x:Key="SurfacePanelBrush" Color="{StaticResource SurfacePanelColor}" />
    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="{StaticResource SurfaceRaisedColor}" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{StaticResource SurfaceHoverColor}" />
    <SolidColorBrush x:Key="SurfaceActiveBrush" Color="{StaticResource SurfaceActiveColor}" />

    <!-- Borders and separators. -->
    <Color x:Key="EdgeColor">#FFD5DCE5</Color>
    <Color x:Key="EdgeStrongColor">#FFB9C3CF</Color>
    <SolidColorBrush x:Key="EdgeBrush" Color="{StaticResource EdgeColor}" />
    <SolidColorBrush x:Key="EdgeStrongBrush" Color="{StaticResource EdgeStrongColor}" />

    <!-- Text. -->
    <Color x:Key="ContentColor">#FF12151A</Color>
    <Color x:Key="ContentMutedColor">#FF4A5462</Color>
    <Color x:Key="ContentFaintColor">#FF6B7684</Color>
    <SolidColorBrush x:Key="ContentBrush" Color="{StaticResource ContentColor}" />
    <SolidColorBrush x:Key="ContentMutedBrush" Color="{StaticResource ContentMutedColor}" />
    <SolidColorBrush x:Key="ContentFaintBrush" Color="{StaticResource ContentFaintColor}" />

    <!-- Accent: family value for fills, darkened value for text (see header). -->
    <Color x:Key="AccentColor">#FF4C8DFF</Color>
    <Color x:Key="AccentHoverColor">#FF3D7CE8</Color>
    <Color x:Key="AccentMutedColor">#FFD9E5FB</Color>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentMutedBrush" Color="{StaticResource AccentMutedColor}" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="#FF1F5FD0" />
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="#FFFFFFFF" />

    <!-- Status. Darkened from the family values so they stay readable on white. -->
    <Color x:Key="DangerColor">#FFC02626</Color>
    <Color x:Key="WarnColor">#FF8A6410</Color>
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="WarnBrush" Color="{StaticResource WarnColor}" />
    <!-- The error panel stays a filled dark-red surface in both themes: it is an
         alert, and inverting it would make it quieter exactly when it must not be. -->
    <SolidColorBrush x:Key="DangerSurfaceBrush" Color="#FF9B1C1C" />
    <SolidColorBrush x:Key="DangerSurfaceForegroundBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="DangerSurfaceMutedForegroundBrush" Color="#FFFFE4E4" />

    <!-- Document surface. The page sheet is content and stays white in both
         themes; only the canvas behind it follows the theme. -->
    <SolidColorBrush x:Key="PageSheetBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="CanvasBrush" Color="#FFDDE2E8" />
    <SolidColorBrush x:Key="PageBorderBrush" Color="{StaticResource EdgeStrongColor}" />

    <!-- Annotation families, darkened from FrameForge's track colours to stay
         legible on light surfaces while keeping the same hue identity. -->
    <SolidColorBrush x:Key="AnnotationHighlightBrush" Color="#FF6A4C94" />
    <SolidColorBrush x:Key="AnnotationNoteBrush" Color="#FF2C5580" />
    <SolidColorBrush x:Key="AnnotationInkBrush" Color="#FF2F6B51" />

    <!-- Selection affordance on the page. -->
    <SolidColorBrush x:Key="SelectionBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="SelectionHandleBrush" Color="#FF1F74C6" />

</ResourceDictionary>
