<!--
    PageForge typography and metric tokens.

    Ported from FrameForge so the two LiVi products share one type voice. Two
    things carry over from that repo:

    - The UI font stack is `Segoe UI Variable Text` falling back to `Segoe UI`
      (FrameForge's `src/styles.css` body rule). Both ship with Windows, so there
      is no font to bundle and no font licence to add to THIRD-PARTY-NOTICES.
      FrameForge's bundled Inter/Playfair/Oswald faces are title fonts for its
      video text tool, not UI chrome, and deliberately are not copied here.

    - The size scale is deliberately dense. FrameForge's `tailwind.config.ts`
      overrides Tailwind's default scale with a 10-15px range because, per its
      PRD 7.4, the stock scale is too large for a desktop productivity tool.
      PageForge is the same kind of tool and uses the same range.

    This dictionary is theme-independent: it is merged once and never swapped,
    so these keys are safe to reference with StaticResource.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <FontFamily x:Key="AppFontFamily">Segoe UI Variable Text, Segoe UI</FontFamily>
    <!-- Display face for the product wordmark and empty-state headline. Segoe UI
         Variable Display is the optical size intended for large text. -->
    <FontFamily x:Key="DisplayFontFamily">Segoe UI Variable Display, Segoe UI</FontFamily>

    <!-- Dense desktop scale: FrameForge 2xs / xs / sm / base / lg. -->
    <sys:Double x:Key="FontSize2XS">10</sys:Double>
    <sys:Double x:Key="FontSizeXS">11</sys:Double>
    <sys:Double x:Key="FontSizeSM">12</sys:Double>
    <sys:Double x:Key="FontSizeBase">13</sys:Double>
    <sys:Double x:Key="FontSizeLG">15</sys:Double>
    <!-- Only for the empty state / About wordmark, not for chrome. -->
    <sys:Double x:Key="FontSizeDisplay">28</sys:Double>

    <!-- Metrics. FrameForge panel headers are a 28px flush bar with uppercase
         tracked labels, and its panel spacing unit is 8px. -->
    <sys:Double x:Key="PanelHeaderHeight">28</sys:Double>
    <sys:Double x:Key="ToolbarButtonHeight">26</sys:Double>
    <Thickness x:Key="PanelPadding">8</Thickness>
    <Thickness x:Key="ToolbarButtonPadding">10,3</Thickness>
    <CornerRadius x:Key="ControlCornerRadius">4</CornerRadius>
    <CornerRadius x:Key="PanelCornerRadius">0</CornerRadius>

    <!-- Uppercase, tracked panel-header label (FrameForge Panel.tsx). -->
    <Style x:Key="PanelHeaderTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize2XS}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource ContentMutedBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

</ResourceDictionary>
