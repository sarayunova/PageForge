<!--
    PageForge dark theme tokens.

    Ported verbatim from FrameForge (LiVi Software Company's video editor) so the
    two products read as one family: see that repo's `tailwind.config.ts`, whose
    surface ramp, edge, content, accent, danger and warn values are reproduced
    here one-for-one. FrameForge's PRD 7.4 calls for a dense, dark desktop
    productivity palette rather than website-style cards; PageForge follows it.

    Tokens.Light.xaml MUST define exactly these keys — ThemeManager swaps one
    dictionary for the other at runtime and every consumer binds with
    DynamicResource, so a key present in one theme and missing in the other is a
    runtime blank, not a build error.

    Contrast (WCAG 2.1 AA, measured against SurfacePanelBrush #121519):
      ContentBrush       #e6e9ee  14.6:1  PASS body text
      ContentMutedBrush  #9aa4b2   7.26:1 PASS body text
      ContentFaintBrush  #6b7684   3.97:1 FAIL body text - DISABLED/LARGE ONLY
      AccentTextBrush    #4c8dff   5.72:1 PASS body text
    Phase 6 took this shell to WCAG 2.1 AA; do not regress it by using
    ContentFaintBrush for normal-size body copy.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Identifies which theme is loaded, for ThemeManager and for any style
         that genuinely must branch (rare - prefer a token). -->
    <sys:String x:Key="ThemeName">Dark</sys:String>

    <!-- Surface ramp: app background -> panel -> raised/header -> hover -> active. -->
    <Color x:Key="SurfaceAppColor">#FF0B0D10</Color>
    <Color x:Key="SurfacePanelColor">#FF121519</Color>
    <Color x:Key="SurfaceRaisedColor">#FF181C22</Color>
    <Color x:Key="SurfaceHoverColor">#FF20252D</Color>
    <Color x:Key="SurfaceActiveColor">#FF2A313A</Color>

    <SolidColorBrush x:Key="SurfaceAppBrush" Color="{StaticResource SurfaceAppColor}" />
    <SolidColorBrush x:Key="SurfacePanelBrush" Color="{StaticResource SurfacePanelColor}" />
    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="{StaticResource SurfaceRaisedColor}" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{StaticResource SurfaceHoverColor}" />
    <SolidColorBrush x:Key="SurfaceActiveBrush" Color="{StaticResource SurfaceActiveColor}" />

    <!-- Borders and separators. -->
    <Color x:Key="EdgeColor">#FF2A313A</Color>
    <Color x:Key="EdgeStrongColor">#FF3A434F</Color>
    <SolidColorBrush x:Key="EdgeBrush" Color="{StaticResource EdgeColor}" />
    <SolidColorBrush x:Key="EdgeStrongBrush" Color="{StaticResource EdgeStrongColor}" />

    <!-- Text. -->
    <Color x:Key="ContentColor">#FFE6E9EE</Color>
    <Color x:Key="ContentMutedColor">#FF9AA4B2</Color>
    <Color x:Key="ContentFaintColor">#FF6B7684</Color>
    <SolidColorBrush x:Key="ContentBrush" Color="{StaticResource ContentColor}" />
    <SolidColorBrush x:Key="ContentMutedBrush" Color="{StaticResource ContentMutedColor}" />
    <SolidColorBrush x:Key="ContentFaintBrush" Color="{StaticResource ContentFaintColor}" />

    <!-- Accent. AccentBrush fills (always paired with AccentForegroundBrush);
         AccentTextBrush is accent-coloured TEXT on a surface, which is a
         different contrast problem and so a separate token. In dark the two
         coincide; in light they must not. -->
    <Color x:Key="AccentColor">#FF4C8DFF</Color>
    <Color x:Key="AccentHoverColor">#FF6BA0FF</Color>
    <Color x:Key="AccentMutedColor">#FF1E3A63</Color>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentMutedBrush" Color="{StaticResource AccentMutedColor}" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="#FFFFFFFF" />

    <!-- Status. -->
    <Color x:Key="DangerColor">#FFE05252</Color>
    <Color x:Key="WarnColor">#FFD9A441</Color>
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="WarnBrush" Color="{StaticResource WarnColor}" />
    <!-- Error panels: a filled danger surface with its own readable foreground. -->
    <SolidColorBrush x:Key="DangerSurfaceBrush" Color="#FF7F1D1D" />
    <SolidColorBrush x:Key="DangerSurfaceForegroundBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="DangerSurfaceMutedForegroundBrush" Color="#FFFFE4E4" />

    <!-- Document surface. The PDF page itself is CONTENT, not chrome: it stays a
         true white sheet in both themes, because tinting it would misrepresent
         the document and break the render-equality expectation. Only the canvas
         behind it follows the theme. -->
    <SolidColorBrush x:Key="PageSheetBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="CanvasBrush" Color="{StaticResource SurfaceAppColor}" />
    <SolidColorBrush x:Key="PageBorderBrush" Color="{StaticResource EdgeStrongColor}" />

    <!-- Annotation families, mapped from FrameForge's per-track colours so the
         two products' category colours share one origin. -->
    <SolidColorBrush x:Key="AnnotationHighlightBrush" Color="#FF8A6BB5" />
    <SolidColorBrush x:Key="AnnotationNoteBrush" Color="#FF3B6EA5" />
    <SolidColorBrush x:Key="AnnotationInkBrush" Color="#FF3F8F6D" />

    <!-- Selection affordance on the page (word highlight, object handles). -->
    <SolidColorBrush x:Key="SelectionBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="SelectionHandleBrush" Color="#FF1F74C6" />

</ResourceDictionary>
