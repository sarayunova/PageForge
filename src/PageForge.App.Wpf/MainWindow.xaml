<!--
    A WPF-UI FluentWindow rather than a plain Window, so the shell gets the
    Windows 11 chrome cues: a Mica backdrop, rounded corners, and a title bar
    that is part of the app rather than a grey strip bolted above it.

    ExtendsContentIntoTitleBar lets the title bar carry real controls, so the
    "Open PDF…" command and the AGPL source link move into it and the separate
    toolbar row they used to occupy is gone entirely - one less band of chrome
    between the user and the document.

    Background is deliberately Transparent: Mica is drawn by the OS behind the
    window, and painting an opaque window background would cover it. The content
    regions paint their own surfaces, so only genuinely empty chrome shows the
    backdrop. On Windows 10, where Mica does not exist, WPF-UI falls back to a
    solid backdrop on its own.
-->
<controls:FluentShellWindow x:Class="PageForge.App.Wpf.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:controls="clr-namespace:PageForge.App.Wpf.Controls"
                 Title="PageForge"
                 Icon="Assets/pageforge.ico"
                 Width="1200" Height="820"
                 MinWidth="900" MinHeight="600"
                 WindowStartupLocation="CenterScreen"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 ExtendsContentIntoTitleBar="True"
                 Background="Transparent"
                 Foreground="{DynamicResource ContentBrush}"
                 FontFamily="{StaticResource AppFontFamily}"
                 FontSize="{StaticResource FontSizeBase}"
                 TextOptions.TextFormattingMode="Display"
                 UseLayoutRounding="True">

    <DockPanel>
        <!-- Title is rendered in Header rather than via TitleBar.Title: setting
             Header takes over the title's slot, so relying on Title alone leaves
             the window with no product name showing at all. Window.Title is still
             "PageForge" for the taskbar and for UIA (the smoke suite finds the
             window by that name). -->
        <ui:TitleBar DockPanel.Dock="Top"
                     AutomationProperties.Name="PageForge title bar">
            <ui:TitleBar.Header>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- The 256px PNG rather than the .ico: WPF would otherwise pick
                         an icon frame by its own rules and can land on a small one,
                         which looks soft when scaled up to the title-bar size. -->
                    <Image Source="Assets/pageforge-256.png" Width="18" Height="18"
                           Margin="12,0,0,0" VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           AutomationProperties.Name="PageForge" />
                    <TextBlock Text="PageForge"
                               FontFamily="{StaticResource DisplayFontFamily}"
                               FontSize="{StaticResource FontSizeLG}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource ContentBrush}"
                               VerticalAlignment="Center" Margin="8,0,0,0" />
                    <Separator Margin="12,6" Width="1"
                               Background="{DynamicResource EdgeStrongBrush}" />
                    <Button x:Name="OpenPdfButton" AutomationProperties.Name="Open PDF…"
                            Click="Open_Click" Padding="10,3"
                            VerticalAlignment="Center"
                            ToolTip="Open one or more PDF documents (FR-VIEW-04 multi-doc tabs)">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="DocumentPdf24" FontSize="14" Margin="0,0,6,0" />
                            <TextBlock Text="Open PDF…" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </ui:TitleBar.Header>
            <ui:TitleBar.TrailingContent>
                <!-- AGPL §13 source availability: point users at the public
                     repository (TSD §7). It belongs in the chrome, not the
                     document surface, so the title bar is the right home. -->
                <TextBlock VerticalAlignment="Center" Margin="0,0,12,0"
                           Foreground="{DynamicResource ContentMutedBrush}">
                    <Hyperlink Click="ViewSource_Click"
                               ToolTip="AGPLv3: view the exact source running here"
                               Foreground="{DynamicResource AccentTextBrush}">
                        View source
                    </Hyperlink>
                </TextBlock>
            </ui:TitleBar.TrailingContent>
        </ui:TitleBar>

        <Grid>
            <TabControl x:Name="DocTabs" Background="Transparent" BorderThickness="0" />

            <!--
                Empty state. With no document open the user used to get a bare
                panel: nothing said what this application was for or what to do
                next, and the only way forward - Open PDF… - lives in the title
                bar, which is not where a first-time user looks.

                Collapsed by default and shown only once there are no tabs, so it
                never flashes over a document that is still loading.
            -->
            <StackPanel x:Name="EmptyState" Visibility="Collapsed"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        MaxWidth="420">
                <Image Source="Assets/pageforge-256.png" Width="72" Height="72"
                       Opacity="0.9" Margin="0,0,0,20"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <controls:HeadingTextBlock HeadingLevel="2"
                                           Text="No document open"
                                           Foreground="{DynamicResource ContentBrush}"
                                           FontSize="20" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" />
                <TextBlock Text="Open a PDF to view, annotate, edit, fill forms or redact it. Everything happens on this machine — nothing is uploaded."
                           Foreground="{DynamicResource ContentMutedBrush}"
                           TextWrapping="Wrap" TextAlignment="Center"
                           Margin="0,10,0,22" />
                <Button x:Name="EmptyStateOpenButton"
                        AutomationProperties.Name="Open a PDF"
                        Click="Open_Click" Padding="16,7"
                        HorizontalAlignment="Center"
                        ToolTip="Choose a PDF to open">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="DocumentAdd24" FontSize="16" Margin="0,0,8,0" />
                        <TextBlock Text="Open PDF…" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </DockPanel>
</controls:FluentShellWindow>
