<Project Sdk="Microsoft.NET.Sdk">

  <!--
    WPF-fallback viewer: the runnable desktop proof for the viewer (FR-VIEW) until the
    WinUI app (src/PageForge.App) can be built on a machine with the VS UWP/MSIX build
    workload. Proves App -> Interop -> Core -> shim -> MuPDF, now as a multi-doc viewer
    (tabs, continuous/single, zoom, rotation, thumbnails, outline, full-text search).
    The canonical product shell remains WinUI 3 in src/PageForge.App; this project is a
    documented fallback proof, not product code. Never delete until WinUI builds locally.
  -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>PageForge.App.Wpf</RootNamespace>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Stamps the icon into the executable itself, so Explorer, the taskbar and
         the installer all show it without the app having to be running. -->
    <ApplicationIcon>Assets\pageforge.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- Brand assets. The .ico is what Windows chrome uses; the 256px PNG is for
       in-app display (title bar, and the empty state once it exists), where a
       PNG avoids the shell's icon-size negotiation entirely. Both are generated
       from assets/brand/pageforge-icon-source.png. -->
  <ItemGroup>
    <Resource Include="Assets\pageforge.ico" />
    <Resource Include="Assets\pageforge-256.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PageForge.MuPdfInterop\PageForge.MuPdfInterop.csproj" />
    <ProjectReference Include="..\PageForge.Core\PageForge.Core.csproj" />
  </ItemGroup>

  <!-- FR-OCR-01: ship the vendored Tesseract traineddata so OCR works offline
       with no TESSDATA_PREFIX on the machine. -->
  <ItemGroup>
    <None Include="..\..\tools\tessdata\eng.traineddata" CopyToOutputDirectory="PreserveNewest" Link="tessdata\eng.traineddata" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

</Project>