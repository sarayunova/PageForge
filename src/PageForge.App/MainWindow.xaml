<Window
    x:Class="PageForge.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="PageForge Phase 0">

    <Grid Padding="12" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="PageForge" Style="{StaticResource TitleTextBlockStyle}" VerticalAlignment="Center" />
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Text="loading sample document..." />
        </StackPanel>

        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollMode="Enabled" VerticalScrollMode="Enabled" ZoomMode="Enabled">
            <Image x:Name="PreviewImage" Stretch="None" />
        </ScrollViewer>

        <TextBlock Grid.Row="2" x:Name="SizeText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
    </Grid>
</Window>